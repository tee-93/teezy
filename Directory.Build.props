<Project>
  <PropertyGroup>
    <!--
      THE VERSION OF RECORD. Bump it here and nowhere else.

      It reaches the installer because tools\build-installer.ps1 reads this file and passes
      it to ISCC, and it reaches Settings ▸ About because it becomes the assembly version.
      Teezy.iss refuses to compile without being told, so the two cannot disagree.

      They did disagree, silently, for four releases: nothing set a version, so every build
      reported 1.0.0 in About while the installer said otherwise.
    -->
    <Version>1.5.0</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- The neutral projects target plain net10.0 precisely so CA1416 turns any accidental
         Win32 call into a build error. That guarantee is worthless as a mere warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>

    <!-- CA1716: "Stop" collides with a Visual Basic keyword. This is a Windows-only C#
         app; there is no cross-language consumer to protect. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>

    <!-- ARM64 is the only target that matters here: the x64 build runs under emulation and
         transcription is dramatically slower. -->
    <Platforms>ARM64</Platforms>
    <!-- Globalization-invariant mode is NOT compatible with WPF: the text layer builds
         new CultureInfo("en") while measuring a TextBlock, which throws
         CultureNotFoundException in invariant mode and kills the process the first time
         any window renders text. Do not set this to true.
         https://aka.ms/GlobalizationInvariantMode -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
