<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Speech. sherpa-onnx bundles its own ONNX Runtime; do NOT also reference
         Microsoft.ML.OnnxRuntime or two copies get loaded. -->
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.5" />
    <PackageVersion Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.5" />

    <!-- Audio. PINNED TO 2.3.0: NAudio 3.x will not restore here. -->
    <PackageVersion Include="NAudio" Version="2.3.0" />

    <!-- Optional LLM cleanup tier. The app runs fully without it. -->
    <PackageVersion Include="Anthropic" Version="12.42.0" />

    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
