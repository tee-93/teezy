<Application x:Class="Teezy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette and shared styles live in their own dictionary so anything
                     hosting these views — the app itself, or a screenshot harness — merges
                     exactly the same definitions rather than duplicating them. -->
                <ResourceDictionary Source="pack://application:,,,/Teezy;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
