<UserControl x:Class="Teezy.App.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">

    <!--
      The shell's right-hand rail: today's tasks and meetings, a place to jot one down, and
      what has happened lately, wherever you are in the app. Closed by default — Open()/Close()/
      Toggle() animate it in and out (see AssistantPanel.xaml.cs), the same BeginAnimation idiom
      AssistantWindow uses for the floating pill. Everything it shows is real: the same stores
      every other page reads from, not sample data.
    -->
    <Border x:Name="Root" Width="0" HorizontalAlignment="Left" ClipToBounds="True"
            Background="{StaticResource Rail}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0">
        <Border x:Name="Inner" Width="260" HorizontalAlignment="Left" Padding="18,18,18,14">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InnerShift"/>
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Text="Assistant" Style="{StaticResource H2}" Margin="0,0,0,14"/>

                <!-- Whether dictation will work right now, and how to start it — the same
                     signal the status bar shows, not a separate one. -->
                <Border Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Faint}"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusText" Text="Loading the speech model…"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentInk}"/>
                        </StackPanel>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}"/>
                <StackPanel x:Name="TodayList" Margin="0,0,0,4"/>
                <TextBlock x:Name="TodayEmpty" Style="{StaticResource Hint}" Text="Nothing due today."
                           Visibility="Collapsed"/>

                <TextBlock Text="QUICK CAPTURE" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                <Border Style="{StaticResource FieldBox}">
                    <Grid>
                        <TextBlock x:Name="CapturePlaceholder" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Text="Add a task…"/>
                        <TextBox x:Name="CaptureBox" Style="{StaticResource BareText}"
                                 TextChanged="OnCaptureTyped" KeyDown="OnCaptureKey"/>
                    </Grid>
                </Border>

                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource SectionLabel}" Margin="0,18,0,4"/>
                <StackPanel x:Name="ActivityList"/>
                <TextBlock x:Name="ActivityEmpty" Style="{StaticResource Hint}" Text="Nothing yet."
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
