<Window x:Class="Teezy.App.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False">

    <!-- Margin leaves room for the shadow to fall outside the pill without being clipped by
         the window edge. PositionAtBottomCenter subtracts it back so the pill itself lands
         exactly where the dictation HUD does. -->
    <Grid Margin="40,28,40,34">
        <Border x:Name="Pill"
                CornerRadius="24"
                Height="50"
                HorizontalAlignment="Center"
                Background="{StaticResource AssistantGlass}"
                RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale"/>
                    <TranslateTransform x:Name="PillShift"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.62" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Border CornerRadius="24" BorderThickness="1"
                        BorderBrush="{StaticResource AssistantEdge}"/>

                <Border CornerRadius="24" Margin="1"
                        Background="{StaticResource AssistantSheen}"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="19,0,21,0">

                    <Grid Width="30" Height="30" Margin="0,0,13,0" VerticalAlignment="Center">

                        <!-- Swells with your voice while listening. -->
                        <Ellipse x:Name="Glow" Width="34" Height="34" Opacity="0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#8057D0FF" Offset="0"/>
                                    <GradientStop Color="#0057D0FF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Viewbox Width="28" Height="28">
                            <Canvas Width="100" Height="104" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="Breathe" CenterX="50" CenterY="52"/>
                                </Canvas.RenderTransform>

                                <!-- The bubble from MarkGeometry's first figure, stroked rather
                                     than filled so the interior is free to be expressive. The
                                     two knocked-out text bars become the face. -->
                                <Path Stroke="{StaticResource HudText}"
                                      StrokeThickness="7"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Data="M30,14 H70 A16,16 0 0 1 86,30 V58 A16,16 0 0 1 70,74 H46 L30,90 V74 A16,16 0 0 1 14,58 V30 A16,16 0 0 1 30,14 Z"/>

                                <Rectangle x:Name="Bar1" Canvas.Left="32" Canvas.Top="30"
                                           Width="28" Height="10" RadiusX="5" RadiusY="5"
                                           Fill="{StaticResource AssistantWave}"/>

                                <Rectangle x:Name="Bar2" Canvas.Left="32" Canvas.Top="48"
                                           Width="20" Height="10" RadiusX="5" RadiusY="5"
                                           Fill="{StaticResource AssistantWave}"/>

                                <!-- Drawn on via the dash offset, so it reads as written. -->
                                <Path x:Name="Tick" Opacity="0"
                                      Stroke="{StaticResource AssistantGood}"
                                      StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeDashArray="6 6"
                                      StrokeDashOffset="6"
                                      Data="M33,45 L44,57 L69,32"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText"
                                   Text="Listening"
                                   Foreground="{StaticResource HudText}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"/>

                        <!-- What it heard, shown only when that is the useful thing to say. -->
                        <TextBlock x:Name="HeardText"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource HudText}"
                                   Opacity="0.62"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   Margin="0,1,0,0"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
