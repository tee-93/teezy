<Window x:Class="Teezy.App.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False">

    <!-- Margin leaves room for the shadow to fall outside the pill without being clipped by
         the window edge. PositionAtBottomCenter subtracts it back so the pill itself lands
         exactly where the dictation HUD does. -->
    <Grid Margin="40,28,40,34">
        <Border x:Name="Pill"
                CornerRadius="{StaticResource PillRadius}"
                Height="{StaticResource PillHeight}"
                HorizontalAlignment="Center"
                Background="{StaticResource PillGlass}"
                BorderBrush="{StaticResource PillEdge}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale"/>
                    <TranslateTransform x:Name="PillShift"/>
                </TransformGroup>
            </Border.RenderTransform>

            <!-- A floating layer, so it casts Fivebar's floating shadow. Nothing else does. -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="19,0,21,0">

                <Grid Width="30" Height="30" Margin="0,0,13,0" VerticalAlignment="Center">

                    <!-- Kept for the code that fades it; there are no glows in the family. -->
                    <Ellipse x:Name="Glow" Width="34" Height="34" Opacity="0" Fill="Transparent"/>

                    <Viewbox Width="24" Height="24">
                        <Grid Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Breathe"/>
                            </Grid.RenderTransform>

                            <!--
                              The mark itself, and it moves: the two tall bars in the middle are
                              the voice meter while listening and the typing indicator while
                              working. Drawn as horizontal bars in a grid turned a quarter-turn,
                              so a bar's Width — which the code animates — reads as its height,
                              and each bar grows from its own centre, like the mark's.
                            -->
                            <Grid>
                                <Grid.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </Grid.LayoutTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="17.5"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="17.5"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="17.5"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="17.5"/>
                                </Grid.RowDefinitions>

                                <Rectangle x:Name="BarA" Grid.Row="0" Width="48" RadiusX="3" RadiusY="3"
                                           HorizontalAlignment="Center" Fill="{StaticResource AssistantWave}"/>
                                <Rectangle x:Name="Bar1" Grid.Row="2" Width="100" RadiusX="3" RadiusY="3"
                                           HorizontalAlignment="Center" Fill="{StaticResource AssistantWave}"/>
                                <Rectangle x:Name="Bar2" Grid.Row="4" Width="74" RadiusX="3" RadiusY="3"
                                           HorizontalAlignment="Center" Fill="{StaticResource AssistantWave}"/>
                                <Rectangle x:Name="BarB" Grid.Row="6" Width="36" RadiusX="3" RadiusY="3"
                                           HorizontalAlignment="Center" Fill="{StaticResource AssistantWave}"/>
                            </Grid>

                            <!-- Drawn on via the dash offset once the bars fade, so it reads as written. -->
                            <Canvas Width="100" Height="100">
                                <Path x:Name="Tick" Opacity="0"
                                      Stroke="{StaticResource AssistantGood}"
                                      StrokeThickness="9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeDashArray="6 6"
                                      StrokeDashOffset="6"
                                      Data="M30,52 L42,64 L70,36"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Grid>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="Listening"
                               Foreground="{StaticResource HudText}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <!-- What it heard, shown only when that is the useful thing to say. -->
                    <TextBlock x:Name="HeardText"
                               Visibility="Collapsed"
                               Foreground="{StaticResource Muted}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12"
                               Margin="0,1,0,0"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- An answer, which is prose rather than a status line: it wraps, and
                         the pill grows to hold it. StatusText carries the heading above. -->
                    <TextBlock x:Name="AnswerText"
                               Visibility="Collapsed"
                               Foreground="{StaticResource Body}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13"
                               LineHeight="19"
                               Margin="0,3,0,0"
                               Width="{StaticResource AnswerWidth}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
