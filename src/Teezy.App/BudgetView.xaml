<UserControl x:Class="Teezy.App.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <!--
      The budget's place in Teezy, made before anything feeds it. Cashew stays where the budget
      is kept; Teezy's part is to gather what is coming up and what has moved, from Cashew and
      from the bills that arrive by email, and show the highlights here and on the dashboard.

      Every card is honestly empty until a source is connected. A dash is the only figure this
      page shows without one — no sample numbers, because a budget page that invents money is
      worse than one that says it has nothing yet.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Text="Budget" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Lede}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Bills coming up, and money in and out, gathered from where they already live."/>

            <Border Style="{StaticResource CardPanel}" Margin="0,20,0,0"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}">
                <StackPanel>
                    <TextBlock Text="Nothing is connected yet" Style="{StaticResource H2}"/>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Body}"
                               Text="Cashew stays where your budget is kept. TeezyFlow will read from it, and from the bills that arrive in your email, and show the highlights here and on the dashboard. Until a source is set up these cards stay empty rather than guess."/>
                </StackPanel>
            </Border>

            <!-- The same proportions as the dashboard, so the two pages read as one design. -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="13*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="DUE THIS WEEK" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="No bills to show yet."/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Money in" Foreground="{StaticResource Body}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="—" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="1" Text="Money out" Foreground="{StaticResource Body}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="2" Text="Left over" Foreground="{StaticResource Ink}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="—" Foreground="{StaticResource Faint}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="RECENT MONEY IN AND OUT" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource Muted}" Text="Nothing to show yet."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
