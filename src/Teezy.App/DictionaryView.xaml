<UserControl x:Class="Teezy.App.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <TextBlock Text="Dictionary" Style="{StaticResource H1}"/>
                <Button x:Name="OpenFileButton" Content="Open as text file"
                        Style="{StaticResource Quiet}" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnOpenFile"/>
            </Grid>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Names and jargon the model keeps getting wrong. Corrections are applied after transcription, so they are guaranteed — unlike hints, which only improve the odds."/>
        </StackPanel>

        <!-- Add -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,20,0,16">
            <StackPanel>
                <!-- Segmented, because these are two shapes of the same thing rather than
                     two unrelated options. -->
                <Border Background="{StaticResource Sunken}" CornerRadius="10" Padding="3"
                        HorizontalAlignment="Left" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="KindCorrection" Content="Fix a mishearing" IsChecked="True"
                                     Style="{StaticResource Segment}" GroupName="Kind" Checked="OnKindChanged"/>
                        <RadioButton x:Name="KindTerm" Content="Teach a word"
                                     Style="{StaticResource Segment}" GroupName="Kind" Checked="OnKindChanged"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="HearPanel" Grid.Column="0">
                        <TextBlock Text="WHEN YOU HEAR" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="HearBox" Style="{StaticResource Field}"
                                 TextChanged="OnDraftChanged" KeyDown="OnDraftKeyDown"/>
                    </StackPanel>

                    <TextBlock x:Name="Arrow" Grid.Column="1" Text="→" FontSize="16" Margin="13,25,13,0"
                               Foreground="{StaticResource Faint}" VerticalAlignment="Top"
                               Height="38" TextAlignment="Center" LineHeight="38"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="WriteLabel" Text="WRITE" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="WriteBox" Style="{StaticResource Field}"
                                 TextChanged="OnDraftChanged" KeyDown="OnDraftKeyDown"/>
                    </StackPanel>

                    <Button x:Name="AddButton" Grid.Column="3" Content="Add" Click="OnAdd"
                            Style="{StaticResource Primary}" Margin="12,25,0,0" Height="38"
                            VerticalAlignment="Top" IsDefault="True"/>
                </Grid>

                <!-- Live warning about the entry being typed, before it is added. -->
                <Border x:Name="DraftWarning" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,10"
                        Style="{StaticResource CautionPanel}">
                    <TextBlock x:Name="DraftWarningText" TextWrapping="Wrap"
                               Foreground="{StaticResource CautionInk}" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock x:Name="CountLabel" Style="{StaticResource SectionLabel}"/>

                <Border x:Name="ListCard" Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <ItemsControl x:Name="Entries">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="16,12" Background="Transparent"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource Tick}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Click="OnToggle" Tag="{Binding}" Margin="0,2,13,0"
                                                  VerticalAlignment="Top"
                                                  ToolTip="Disabled entries stay in the file but stop firing"/>

                                        <StackPanel Grid.Column="1" Opacity="{Binding DimmedOpacity}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Hear}" Foreground="{StaticResource Muted}"
                                                           Visibility="{Binding HearVisibility}"/>
                                                <TextBlock Text=" → " Foreground="{StaticResource Faint}"
                                                           Visibility="{Binding HearVisibility}"/>
                                                <TextBlock Text="{Binding Write}" Foreground="{StaticResource Ink}"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="{StaticResource AccentSoft}" CornerRadius="4"
                                                        Padding="6,1" Margin="10,0,0,0"
                                                        Visibility="{Binding TermTagVisibility}">
                                                    <TextBlock Text="hint only" FontSize="10.5"
                                                               Foreground="{StaticResource AccentInk}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{StaticResource CautionInk}" Margin="0,5,0,0"
                                                       Visibility="{Binding WarningVisibility}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource Quiet}"
                                                FontSize="12" Click="OnDelete" Tag="{Binding}"
                                                VerticalAlignment="Top" Opacity="0" x:Name="DeleteButton"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeleteButton" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border x:Name="EmptyState" Visibility="Collapsed" Padding="30,40"
                        Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No entries yet" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource Muted}" MaxWidth="420" TextWrapping="Wrap"
                                   Text="Add a name the model keeps mangling. Corrections run after transcription, so the spelling is guaranteed rather than merely likely."/>
                    </StackPanel>
                </Border>

                <Border Height="24"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
