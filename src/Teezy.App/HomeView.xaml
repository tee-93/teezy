<UserControl x:Class="Teezy.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="32,26,32,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="286"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- greeting · day band · today and inbox · search · history -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Greeting" Grid.Row="0" Grid.Column="0" Style="{StaticResource H1}"
                   Text="Welcome back"/>
        <TextBlock x:Name="Subtitle" Grid.Row="0" Grid.Column="0" Margin="0,38,0,0"
                   Foreground="{StaticResource Muted}" FontSize="13"/>

        <!-- The hotkey, where the eye lands first on a page you opened to check something. -->
        <Border Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="999" Padding="11,6" Background="{StaticResource Card}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hold" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource Hover}" CornerRadius="6" Margin="8,0,0,0"
                        Padding="7,2">
                    <TextBlock x:Name="HotkeyChip" Foreground="{StaticResource Ink}" FontSize="11.5"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!--
          The day, said in one line, across the top. The page opens with the assistant telling
          you what is going on rather than with figures to assemble into a sentence yourself,
          and it is composed from the same readings the spoken answers use — so the window and
          the pill cannot describe different days.

          Collapsed until there is something to say. Most of Teezy has never needed an account,
          and an empty band is worse than no band.
        -->
        <Border x:Name="SummaryBand" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource CardPanel}" Padding="20" Margin="0,22,0,0"
                Visibility="Collapsed"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center"
                        Background="{StaticResource AccentWash}">
                    <Path Data="{StaticResource MarkGeometry}" Fill="White" Stretch="Uniform"
                          Width="18" Height="18"/>
                </Border>
                <TextBlock x:Name="SummaryText" Style="{StaticResource H2}" FontSize="17"
                           TextWrapping="Wrap" LineHeight="24" Margin="15,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Today and the inbox, side by side, in the proportions the mock-up settled on. -->
        <Border x:Name="TodayCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource CardPanel}"
                Margin="0,14,0,0" Padding="20" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <TextBlock x:Name="TodayCount" HorizontalAlignment="Right" FontSize="11.5"
                               Foreground="{StaticResource Faint}"/>
                </Grid>
                <ItemsControl x:Name="TodayList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" FontSize="12.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Width="3" CornerRadius="2" MinHeight="26"
                                        Background="{StaticResource AccentWash}"/>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding What}" FontSize="13.5"
                                               Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Where}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TodayEmpty" FontSize="12.5" Foreground="{StaticResource Muted}"
                           Visibility="Collapsed" Text="Nothing else in your diary today."/>
            </StackPanel>
        </Border>

        <Border x:Name="InboxCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource CardPanel}"
                Margin="0,14,0,0" Padding="20" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="INBOX" Style="{StaticResource SectionLabel}" Margin="0"/>
                    <TextBlock x:Name="InboxCount" HorizontalAlignment="Right" FontSize="11.5"
                               Foreground="{StaticResource Faint}"/>
                </Grid>
                <ItemsControl x:Name="InboxList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9"
                                        Background="{StaticResource Hover}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initials}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource Body}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Text="{Binding Who}" FontSize="13"
                                               Foreground="{StaticResource Ink}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subject}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InboxEmpty" FontSize="12.5" Foreground="{StaticResource Muted}"
                           Visibility="Collapsed" Text="Nothing unread."/>
            </StackPanel>
        </Border>


        <!-- Search -->
        <!-- Right margin matches the scroll viewer's padding plus its scrollbar, so the
             search field lines up with the cards below it rather than overhanging them. -->
        <Border Grid.Row="3" Grid.Column="0" Margin="0,22,22,14" Height="38"
                Background="{StaticResource Card}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <Path Data="M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 M15,15 L20,20"
                      Stroke="{StaticResource Faint}" StrokeThickness="1.8" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform"
                      HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" Margin="36,0,12,0"
                         Foreground="{StaticResource Ink}" TextChanged="OnSearchChanged"/>
                <TextBlock x:Name="SearchHint" Text="Search everything you have dictated"
                           Foreground="{StaticResource Faint}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="37,0,0,0"/>
            </Grid>
        </Border>

        <!-- History -->
        <ScrollViewer Grid.Row="4" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Margin="0,0,0,0">
            <StackPanel>
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Header}" Style="{StaticResource SectionLabel}"/>
                                <Border Background="{StaticResource Card}" CornerRadius="12"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Padding="16,13" Background="Transparent"
                                                        BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                                   Foreground="{StaticResource Faint}"
                                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Ink}"
                                                                       LineHeight="20"/>
                                                            <TextBlock Text="{Binding Meta}" FontSize="11"
                                                                       Foreground="{StaticResource Faint}"
                                                                       Margin="0,5,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel x:Name="Actions" Grid.Column="2"
                                                                    Orientation="Horizontal" Opacity="0"
                                                                    VerticalAlignment="Top">
                                                            <Button Content="Copy" Style="{StaticResource Quiet}"
                                                                    FontSize="12" Click="OnCopy" Tag="{Binding}"/>
                                                            <Button Content="Delete" Style="{StaticResource Quiet}"
                                                                    FontSize="12" Click="OnDelete" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- Actions stay hidden until hover, so a long list reads
                                                         as text rather than as rows of buttons. -->
                                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Visibility="Collapsed" Padding="30,44"
                        Background="{StaticResource Card}" CornerRadius="12"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- The full logo. An empty state is all space, so this is the one
                             place in the window the mark gets to be read properly. -->
                        <Image Source="{StaticResource MarkImage}" Height="64" Stretch="Uniform"
                               HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="Nothing dictated yet" Style="{StaticResource H2}"
                                   Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Margin="0,5,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Muted}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Height="24"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Stats sidebar -->
        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,0">
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TotalWords" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="total words" Style="{StaticResource StatCaption}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="Wpm" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="words / min" Style="{StaticResource StatCaption}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Streak" Style="{StaticResource StatNumber}"/>
                        <TextBlock x:Name="StreakCaption" Style="{StaticResource StatCaption}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0"
                    Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}">
                <StackPanel>
                    <TextBlock Text="TIME SAVED" Style="{StaticResource SectionLabel}"
                               Foreground="{StaticResource AccentInk}"/>
                    <TextBlock x:Name="TimeSaved" Style="{StaticResource StatNumber}"
                               Foreground="{StaticResource AccentInk}"/>
                    <TextBlock x:Name="TimeSavedHint" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentInk}" Opacity="0.75" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
