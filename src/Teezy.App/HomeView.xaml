<UserControl x:Class="Teezy.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <!--
      Scrolls, because the stacked sections are taller than the window. Before the week was added
      the dashboard happened to fit, which is not the same as being built to.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,26,32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- greeting · day band · the sections · figures -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Greeting" Grid.Row="0" Grid.Column="0" Style="{StaticResource H1}"
                   Text="Welcome back"/>
        <TextBlock x:Name="Subtitle" Grid.Row="0" Grid.Column="0" Margin="0,38,0,0"
                   Foreground="{StaticResource Muted}" FontSize="13"/>

        <!--
          The hotkey, where the eye lands first on a page you opened to check something.

          A fixed height with a matching radius, not CornerRadius 999 on an auto-sized box: the
          stadium shape only looks right when the radius is exactly half the height, and letting
          the content decide the height made the ends into lopsided ellipses.
        -->
        <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                Height="30" CornerRadius="15" Padding="12,0" Background="{StaticResource Card}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Hold" Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource Hover}" CornerRadius="6" Margin="8,0,0,0"
                        Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="HotkeyChip" Foreground="{StaticResource Ink}" FontSize="11.5"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!--
          The day, said in one line, across the top. The page opens with the assistant telling
          you what is going on rather than with figures to assemble into a sentence yourself,
          and it is composed from the same readings the spoken answers use — so the window and
          the pill cannot describe different days.

          Collapsed until there is something to say. Most of Teezy has never needed an account,
          and an empty band is worse than no band.
        -->
        <Border x:Name="SummaryBand" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Style="{StaticResource CardPanel}" Padding="20" Margin="0,22,0,0"
                Visibility="Collapsed"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentSoft}">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="11" VerticalAlignment="Center"
                        Background="{StaticResource AccentWash}">
                    <Path Data="{StaticResource MarkGeometry}" Fill="White" Stretch="Uniform"
                          Width="18" Height="18"/>
                </Border>
                <TextBlock x:Name="SummaryText" Style="{StaticResource H2}" FontSize="17"
                           TextWrapping="Wrap" LineHeight="24" Margin="15,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!--
          The sections: your day, your week, the inbox. Stacked full width, one above another,
          rather than in two columns. Side by side, a quiet day and a full inbox could never be
          the same height, so their edges never lined up; stacked, every card shares both edges
          with the page and they line up by construction.

          Each opens and closes from its header, and stays how it was left. The counts sit in the
          headers, so a closed section still says how much is in it.
        -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">

            <Border x:Name="TodayCard" Style="{StaticResource CardPanel}" Margin="0,14,0,0" Padding="20,18"
                    Visibility="Collapsed">
                <StackPanel>
                    <ToggleButton x:Name="DayToggle" Style="{StaticResource SectionToggle}" Tag="day"
                                  Checked="OnSectionToggled" Unchecked="OnSectionToggled">
                        <Grid>
                            <TextBlock Text="YOUR DAY" Style="{StaticResource SectionLabel}" Margin="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TodayCount" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>

                    <StackPanel x:Name="DayBody" Margin="0,14,0,0">
                        <ItemsControl x:Name="TodayList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11" Opacity="{Binding Dim}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" FontSize="12.5"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="{Binding RailWidth}" CornerRadius="2" MinHeight="26"
                                                Background="{StaticResource AccentWash}"/>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding What}" FontSize="13.5" TextDecorations="{Binding Strike}"
                                                       Foreground="{StaticResource Ink}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Where}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TodayEmpty" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   Visibility="Collapsed" Text="Nothing else in your diary today."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
              Sunday to Saturday, a line a day. The day card above is the detail; this is the shape
              of the week, so today is in it too, marked, and the days already gone are faded
              rather than dropped. Every day is listed even when empty, because a free Thursday is
              exactly what someone glancing at a week is looking for.
            -->
            <Border x:Name="WeekCard" Style="{StaticResource CardPanel}" Margin="0,14,0,0" Padding="20,18"
                    Visibility="Collapsed">
                <StackPanel>
                    <ToggleButton x:Name="WeekToggle" Style="{StaticResource SectionToggle}" Tag="week"
                                  Checked="OnSectionToggled" Unchecked="OnSectionToggled">
                        <Grid>
                            <TextBlock Text="YOUR WEEK" Style="{StaticResource SectionLabel}" Margin="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WeekCount" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>

                    <ItemsControl x:Name="WeekList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                                        Padding="0,9" Opacity="{Binding Dim}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="3" Height="14" CornerRadius="2" Margin="0,2,7,0"
                                                    Background="{StaticResource AccentWash}"
                                                    Visibility="{Binding TodayMarker}"/>
                                            <TextBlock Text="{Binding Day}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="{Binding Date}" FontSize="11.5" Margin="6,1,0,0"
                                                       Foreground="{StaticResource Faint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding When}" FontSize="12"
                                                                       Foreground="{StaticResource Muted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="12.5"
                                                                       Foreground="{StaticResource Ink}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Nothing booked" FontSize="12" Foreground="{StaticResource Faint}"
                                                       Visibility="{Binding EmptyVisibility}"/>
                                            <TextBlock Text="{Binding More}" FontSize="11.5" Foreground="{StaticResource Faint}"
                                                       Visibility="{Binding MoreVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="InboxCard" Style="{StaticResource CardPanel}" Margin="0,14,0,0" Padding="20,18"
                    Visibility="Collapsed">
                <StackPanel>
                    <ToggleButton x:Name="InboxToggle" Style="{StaticResource SectionToggle}" Tag="inbox"
                                  Checked="OnSectionToggled" Unchecked="OnSectionToggled">
                        <Grid>
                            <TextBlock Text="INBOX" Style="{StaticResource SectionLabel}" Margin="0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="InboxCount" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        </Grid>
                    </ToggleButton>

                    <StackPanel x:Name="InboxBody" Margin="0,12,0,0">
                        <!--
                          A ListBox rather than an ItemsControl with a click handler on the rows. The
                          rows are a list of things you pick one of, which is what a ListBox is for,
                          and using it brings keyboard focus and arrow-key movement along with the
                          mouse — the hand-rolled version was mouse-only.
                        -->
                        <ListBox x:Name="InboxList" Style="{StaticResource PlainList}"
                                 ItemContainerStyle="{StaticResource InboxRowItem}"
                                 SelectionChanged="OnMessageOpened">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="9"
                                                Background="{StaticResource Hover}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Initials}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Body}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Who}" FontSize="13"
                                                           Foreground="{StaticResource Ink}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Which mailbox it landed in. Two accounts merge
                                                     into one list, and "who is this from" is a
                                                     different question from "where do I reply". -->
                                                <Border Background="{StaticResource Hover}" CornerRadius="5"
                                                        Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Mailbox}" FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Faint}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="InboxEmpty" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   Visibility="Collapsed" Text="Nothing unread."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
          The dictation figures, as one strip rather than a sidebar. Four numbers in a row is how
          a dashboard states a total, and it closes the page off under the sections.
        -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardPanel}"
                Margin="0,14,0,0" Padding="22,18" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TotalWords" Style="{StaticResource StatNumber}" FontSize="28"/>
                    <TextBlock Text="total words" Style="{StaticResource StatCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Wpm" Style="{StaticResource StatNumber}" FontSize="28"/>
                    <TextBlock Text="words / min" Style="{StaticResource StatCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Streak" Style="{StaticResource StatNumber}" FontSize="28"/>
                    <TextBlock x:Name="StreakCaption" Style="{StaticResource StatCaption}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="TimeSaved" Style="{StaticResource StatNumber}" FontSize="28"
                               Foreground="{StaticResource AccentDeep}"/>
                    <TextBlock Text="saved vs typing" Style="{StaticResource StatCaption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
</UserControl>
