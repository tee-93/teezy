<UserControl x:Class="Teezy.App.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <!--
      Home is the day's update: a greeting and one line saying the day, tiles across the top,
      then two columns of panels — about two thirds for today and the week, one third for what
      is coming and coming in. Everything but the header is built in code (HomeView.Tiles.cs,
      HomeView.Panels.cs), because which tiles and panels appear, and in what order, is the
      user's choice (Customise).

      Full without any account: every default is made from tasks, notes, meetings and dictation,
      which exist on the locked-down work laptop too. Calendar and mail join where connected.
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PageGrid" Margin="28,24,28,28" SizeChanged="OnPageSized">
        <Grid.RowDefinitions>
            <!-- header · customise · tiles · columns -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The greeting, the date, and the day in one line. -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Greeting" Style="{StaticResource Display}" Text="Good morning"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DateLine" Style="{StaticResource Lede}" Margin="0,2,0,0"/>
                <TextBlock x:Name="BriefLine" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Hold" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource KeyCap}" Margin="6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyChip" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    </Border>
                    <TextBlock Text="to dictate" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="FocusButton" Content="Focus list" Style="{StaticResource Quiet}"
                            Click="OnFocus" ToolTip="A small always-on-top list of pinned tasks, for calls"/>
                    <Button x:Name="BriefingButton" Content="Briefing" Style="{StaticResource Quiet}"
                            Click="OnBriefing" ToolTip="Show this morning's briefing"/>
                    <Button x:Name="CustomiseButton" Content="Customise" Style="{StaticResource Quiet}"
                            Margin="4,0,0,0" Click="OnCustomise" ToolTip="Choose the tiles and panels on Home"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Customise: tick, order, done. Saved as it changes. -->
        <Border x:Name="CustomisePanel" Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,14"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CUSTOMISE HOME" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Style="{StaticResource FormHint}"
                                   Text="Tick what to show and put it in order. Changes save as you go, and travel with Sync."/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Done" Style="{StaticResource Primary}" VerticalAlignment="Top" Click="OnCustomise"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="CustomiseTiles"/>
                    <StackPanel x:Name="CustomiseLeft" Grid.Column="2"/>
                    <StackPanel x:Name="CustomiseRight" Grid.Column="4"/>
                </Grid>
                <TextBlock x:Name="CustomiseAccounts" Style="{StaticResource FormHint}" Margin="0,10,0,0"
                           Text="Connect Microsoft or Google in Settings ▸ Accounts to add Next meeting, Unread and the Inbox."/>
            </StackPanel>
        </Border>

        <!-- The tiles: equal columns, wrapping on a narrow window. -->
        <UniformGrid x:Name="TilesHost" Grid.Row="2" Rows="1" Margin="-6,0,-6,14"/>

        <!-- Two columns, 65 / 35, stacking when the window is narrow. -->
        <Grid x:Name="Columns" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftWidth" Width="13*"/>
                <ColumnDefinition x:Name="GapWidth" Width="14"/>
                <ColumnDefinition x:Name="RightWidth" Width="7*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="LeftColumn" VerticalAlignment="Top"/>
            <StackPanel x:Name="RightColumn" Grid.Column="2" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
