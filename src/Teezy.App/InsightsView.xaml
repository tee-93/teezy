<UserControl x:Class="Teezy.App.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="32,26,32,28">

            <TextBlock Text="Insights" Style="{StaticResource H1}"/>
            <TextBlock x:Name="Subtitle" Margin="0,4,0,0" Foreground="{StaticResource Muted}"/>

            <!-- Headline numbers -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="Wpm" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="WORDS PER MINUTE" Style="{StaticResource SectionLabel}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="WpmHint" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="Fixes" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="DICTIONARY FIXES" Style="{StaticResource SectionLabel}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="FixesHint" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock x:Name="TotalWords" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="TOTAL WORDS DICTATED" Style="{StaticResource SectionLabel}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TotalWordsHint" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Where it goes -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Where it goes" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="AppCount" Style="{StaticResource StatCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="AppBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Height="9" CornerRadius="5"
                                                Background="{StaticResource AccentSoft}"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" CornerRadius="5"
                                                    Background="{StaticResource Accent}"
                                                    Width="{Binding BarWidth}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding Label}" Margin="12,0,0,0"
                                                   Foreground="{StaticResource Muted}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AppsEmpty" Visibility="Collapsed"
                                   Foreground="{StaticResource Faint}"
                                   Text="Nothing dictated yet."/>
                    </StackPanel>
                </Border>

                <!-- Streak -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StreakNumber" Style="{StaticResource H2}"/>
                                <TextBlock Text=" day streak" Style="{StaticResource H2}"/>
                            </StackPanel>
                            <TextBlock x:Name="LongestStreak" Style="{StaticResource StatCaption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 26 weeks of activity, built in code. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="DayLabels" Grid.Column="0" Margin="0,0,7,0"/>
                            <ItemsControl x:Name="Heatmap" Grid.Column="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="Less" Foreground="{StaticResource Faint}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel x:Name="Legend" Orientation="Horizontal"/>
                            <TextBlock Text="More" Foreground="{StaticResource Faint}" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What the Claude tier has cost. Hidden entirely when it has never run, so
                 someone using Teezy offline never sees a card about money. -->
            <Border x:Name="SpendCard" Style="{StaticResource CardPanel}" Margin="0,18,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="SpendMonth" Style="{StaticResource StatNumber}"/>
                            <TextBlock Text="CLEANUP THIS MONTH" Style="{StaticResource SectionLabel}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock x:Name="SpendTotal" Style="{StaticResource StatCaption}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:Name="SpendTokens" Style="{StaticResource StatCaption}"
                                       HorizontalAlignment="Right" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="ModelRows" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Foreground="{StaticResource Body}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                               Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Cost}"
                                               Foreground="{StaticResource Ink}" FontSize="12.5"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="SpendNote" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
