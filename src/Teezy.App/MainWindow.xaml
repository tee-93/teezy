<Window x:Class="Teezy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teezy" Width="1080" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <Window.Resources>
        <!-- Nav rail button: an icon over a soft brand pill when selected. -->
        <Style x:Key="RailButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Width="40" Height="40" CornerRadius="11"
                                Background="Transparent" ToolTip="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#E9E9EF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav rail -->
        <Border Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- The mark, doubling as the app's identity in the corner. -->
                <Border DockPanel.Dock="Top" Width="34" Height="34" CornerRadius="10"
                        Background="{StaticResource Accent}" Margin="0,16,0,18">
                    <Path Data="{StaticResource MarkGeometry}" Fill="White" Stretch="Uniform"
                          Width="19" Height="19" Margin="0,1,0,0"/>
                </Border>

                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavHome" Style="{StaticResource RailButton}" Tag="Home" GroupName="Nav"
                                 IsChecked="True" Checked="OnNavChanged">
                        <Path Data="M4,10 L12,3 L20,10 L20,20 L14,20 L14,14 L10,14 L10,20 L4,20 Z"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavInsights" Style="{StaticResource RailButton}" Tag="Insights" GroupName="Nav"
                                 Checked="OnNavChanged">
                        <Path Data="M4,20 L4,12 M10,20 L10,5 M16,20 L16,9 M22,20 L22,14"
                              Stroke="{StaticResource Ink}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavDictionary" Style="{StaticResource RailButton}" Tag="Dictionary" GroupName="Nav"
                                 Checked="OnNavChanged">
                        <Path Data="M5,4 L14,4 A5,5 0 0 1 19,9 L19,20 L9,20 A4,4 0 0 1 5,16 Z M5,16 L19,16"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>

                <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Tag="Settings" GroupName="Nav"
                             Style="{StaticResource RailButton}" HorizontalAlignment="Center"
                             Margin="0,0,0,14" Checked="OnNavChanged">
                    <Path Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13.4,5.2 L16.8,4.4 L16.6,7.9 L19.8,9.4 L17.6,12 L19.8,14.6 L16.6,16.1 L16.8,19.6 L13.4,18.8 L12,22 L10.6,18.8 L7.2,19.6 L7.4,16.1 L4.2,14.6 L6.4,12 L4.2,9.4 L7.4,7.9 L7.2,4.4 L10.6,5.2 Z"
                          Stroke="{StaticResource Ink}" StrokeThickness="1.5" Fill="Transparent"
                          StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                </RadioButton>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1"/>
    </Grid>
</Window>
