<Window x:Class="Teezy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeezyFlow" Width="1440" Height="900" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <Window.Resources>
        <!-- A rail icon, drawn in whatever colour the tab's text is — same trick as the old
             top-strip tabs, just bigger, since there is no label beside it any more. -->
        <Style x:Key="RailIcon" TargetType="Path">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>
    </Window.Resources>

    <!--
      A slim icon rail down the left — the mark at its head, the pages below, Settings on its
      own at the foot — with the page itself filling the rest, and a status bar along the
      bottom. No separate top strip: one dark surface reads as one piece of chrome, where a
      strip sitting flush above the rail read as two things pretending to be one.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
          Fivebar's update bar: shown once a newer version has been downloaded and checked. The
          close button hides the bar and nothing else: the update still installs on quit.
        -->
        <Border x:Name="UpdateBar" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource AccentSoft}"
                BorderBrush="{StaticResource AssistantGood}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="✕" Margin="6,0,0,0"
                        ToolTip="Later: it installs next time you quit TeezyFlow" Click="OnHideUpdate"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Restart now"
                        Click="OnRestartToUpdate"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap">
                    <Run x:Name="UpdateVersion" FontWeight="SemiBold"/>
                    <Run Text="is ready to install. It takes a few seconds, and nothing you have dictated is lost."/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ============================== Rail and page ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="64" Background="{StaticResource Rail}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Path Data="{StaticResource MarkGeometry}" Fill="{StaticResource Accent}"
                              Stretch="Uniform" Width="22" Height="22" Margin="0,0,0,20"
                              ToolTip="TeezyFlow"/>

                        <RadioButton x:Name="NavHome" Style="{StaticResource RailTab}" GroupName="Nav"
                                     IsChecked="True" ToolTip="Home" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M4,10 L12,3 L20,10 L20,20 L14,20 L14,14 L10,14 L10,20 L4,20 Z"/>
                        </RadioButton>

                        <RadioButton x:Name="NavTasks" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Tasks" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M4,5 L20,5 L20,20 L4,20 Z M8,12 L11,15 L16,9"/>
                        </RadioButton>

                        <RadioButton x:Name="NavTranscripts" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Transcripts" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7 M9,11 L16,11 M9,14.5 L16,14.5 M9,18 L13,18"/>
                        </RadioButton>

                        <RadioButton x:Name="NavMeetings" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Meetings" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M9,7.5 A3.5,3.5 0 1 1 9,7.51 Z M2.5,20 C2.5,15.8 5.4,13.5 9,13.5 C12.6,13.5 15.5,15.8 15.5,20 M15.5,4.2 A3.3,3.3 0 0 1 15.5,10.8 M17.6,13.9 C20.1,14.6 21.5,16.8 21.5,20"/>
                        </RadioButton>

                        <RadioButton x:Name="NavQuotes" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Quotes" Checked="OnNavChanged">
                            <!-- A document with a line of figures on it. -->
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7 M9,12 L16,12 M9,16 L13,16"/>
                        </RadioButton>

                        <RadioButton x:Name="NavInsights" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Insights" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M4,20 L4,12 M10,20 L10,5 M16,20 L16,9 M22,20 L22,14"/>
                        </RadioButton>

                        <RadioButton x:Name="NavDictionary" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Dictionary" Checked="OnNavChanged">
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M5,4 L14,4 A5,5 0 0 1 19,9 L19,20 L9,20 A4,4 0 0 1 5,16 Z M5,16 L19,16"/>
                        </RadioButton>
                    </StackPanel>

                    <!-- Settings sits apart at the foot of the rail. Still a page in the same group. -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <RadioButton x:Name="NavSettings" Style="{StaticResource RailTab}" GroupName="Nav"
                                     ToolTip="Settings" Checked="OnNavChanged">
                            <!-- A ring, a hub and eight short teeth: the ring is what makes it a gear. -->
                            <Path Style="{StaticResource RailIcon}"
                                  Data="M18.3,12 A6.3,6.3 0 1 1 18.29,11.9 Z M14.6,12 A2.6,2.6 0 1 1 14.59,11.9 Z
                                        M18.3,12 L20.9,12 M5.7,12 L3.1,12 M12,5.7 L12,3.1 M12,18.3 L12,20.9
                                        M16.45,7.55 L18.29,5.71 M7.55,16.45 L5.71,18.29 M16.45,16.45 L18.29,18.29 M7.55,7.55 L5.71,5.71"/>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1"/>
        </Grid>

        <!-- ============================== Status bar ============================== -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="0,1,0,0" MinHeight="28" Padding="12,4">
            <DockPanel LastChildFill="False" TextBlock.FontSize="12"
                       TextBlock.Foreground="{StaticResource Muted}">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Faint}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusModel" Text="Loading the speech model…"/>
                    <TextBlock Text="·" Margin="10,0"/>
                    <TextBlock x:Name="StatusHotkeys" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <TextBlock x:Name="StatusVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
