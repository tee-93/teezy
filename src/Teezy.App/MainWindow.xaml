<Window x:Class="Teezy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teezy" Width="1080" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <Window.Resources>
        <!-- Nav rail button: an icon over a soft brand pill when selected. -->
        <Style x:Key="RailButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Width="40" Height="40" CornerRadius="11"
                                Background="Transparent" ToolTip="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav rail -->
        <Border Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- The mark, doubling as the app's identity in the corner. The small glyph
                     rather than the full logo: at 34 px the waves and sparkle would be mush,
                     and the rail wants one solid shape anyway. -->
                <Border DockPanel.Dock="Top" Width="34" Height="34" CornerRadius="10"
                        Background="{StaticResource AccentWash}" Margin="0,16,0,18">
                    <Path Data="{StaticResource MarkGeometry}" Fill="White" Stretch="Uniform"
                          Width="19" Height="19"/>
                </Border>

                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavHome" Style="{StaticResource RailButton}" Tag="Home" GroupName="Nav"
                                 IsChecked="True" Checked="OnNavChanged">
                        <Path Data="M4,10 L12,3 L20,10 L20,20 L14,20 L14,14 L10,14 L10,20 L4,20 Z"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavTranscripts" Style="{StaticResource RailButton}" Tag="Transcripts"
                                 GroupName="Nav" Checked="OnNavChanged">
                        <!-- Lines of text on a page: what the list actually is. -->
                        <Path Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M15,3 L15,7 L19,7
                                    M9,11 L16,11 M9,14.5 L16,14.5 M9,18 L13,18"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavMeetings" Style="{StaticResource RailButton}" Tag="Meetings"
                                 GroupName="Nav" Checked="OnNavChanged">
                        <!-- Two people: the one page in the rail about other people talking. -->
                        <Path Data="M5.5,7.5 A3.5,3.5 0 1 1 5.5,7.51 Z
                                    M2.5,20 C2.5,15.8 5.4,13.5 9,13.5 C12.6,13.5 15.5,15.8 15.5,20
                                    M15.5,4.2 A3.3,3.3 0 0 1 15.5,10.8
                                    M17.6,13.9 C20.1,14.6 21.5,16.8 21.5,20"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavInsights" Style="{StaticResource RailButton}" Tag="Insights" GroupName="Nav"
                                 Checked="OnNavChanged">
                        <Path Data="M4,20 L4,12 M10,20 L10,5 M16,20 L16,9 M22,20 L22,14"
                              Stroke="{StaticResource Ink}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="NavDictionary" Style="{StaticResource RailButton}" Tag="Dictionary" GroupName="Nav"
                                 Checked="OnNavChanged">
                        <Path Data="M5,4 L14,4 A5,5 0 0 1 19,9 L19,20 L9,20 A4,4 0 0 1 5,16 Z M5,16 L19,16"
                              Stroke="{StaticResource Ink}" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" Width="19" Height="19" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>

                <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Tag="Settings" GroupName="Nav"
                             Style="{StaticResource RailButton}" HorizontalAlignment="Center"
                             Margin="0,0,0,14" Checked="OnNavChanged">
                    <!--
                      A ring with a hub and eight short teeth. Two earlier attempts failed the
                      same way at nineteen pixels: a twenty-vertex toothed outline rendered as a
                      spiky blob, and a hub with long spokes and no ring read as a sun. The ring
                      is what makes it a gear, and the teeth have to barely protrude.
                    -->
                    <Path Data="M18.3,12 A6.3,6.3 0 1 1 18.29,11.9 Z
                                M14.6,12 A2.6,2.6 0 1 1 14.59,11.9 Z
                                M18.3,12 L20.9,12 M5.7,12 L3.1,12
                                M12,5.7 L12,3.1 M12,18.3 L12,20.9
                                M16.45,7.55 L18.29,5.71 M7.55,16.45 L5.71,18.29
                                M16.45,16.45 L18.29,18.29 M7.55,7.55 L5.71,5.71"
                          Stroke="{StaticResource Ink}" StrokeThickness="1.8" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="19" Height="19" Stretch="Uniform"/>
                </RadioButton>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1"/>
    </Grid>
</Window>
