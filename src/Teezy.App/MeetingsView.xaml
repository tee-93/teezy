<UserControl x:Class="Teezy.App.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <!--
      Meeting notes, first build. It exists to answer one question on the work laptop: does
      recording a Teams meeting and transcribing it afterwards work there, and how long does
      the wait turn out to be. So the recorder is honest about what it can hear, and every
      finished meeting says how long it took.

      Nothing here joins the call. That is why it works without anyone's permission, and also
      why nobody in the meeting can tell it is running — so the page says so, every time.
    -->
    <!--
      The whole page scrolls, not just the list. With the recorder and the progress card fixed
      above a scrolling list, a short window squeezed the meetings into a sliver.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Meetings" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Lede}" Margin="0,4,0,0"
                       Text="Recorded on this computer and transcribed once the meeting is over."/>
        </StackPanel>

        <!-- The recorder -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock x:Name="RecorderTitle" Text="Record a meeting" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="RecorderHint" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Records your microphone and whatever your speakers play. Nothing joins the call, so nobody in it can see this running — let people know you are taking notes."/>

                    <!-- One meter per side. The second one moving is the proof that this
                         computer lets Teezy hear the call at all. -->
                    <Grid x:Name="Meters" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" MinWidth="150">
                            <TextBlock Text="You" Foreground="{StaticResource Ink}"/>
                            <TextBlock x:Name="MeName" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        </StackPanel>
                        <Border x:Name="MeTrack" Grid.Row="0" Grid.Column="1" Height="6" CornerRadius="2"
                                Background="{StaticResource Sunken}" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Border x:Name="MeFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"
                                    Background="{StaticResource Accent}"/>
                        </Border>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Everyone else" Foreground="{StaticResource Ink}"/>
                            <TextBlock x:Name="ThemName" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        </StackPanel>
                        <Border x:Name="ThemTrack" Grid.Row="1" Grid.Column="1" Height="6" CornerRadius="2"
                                Background="{StaticResource Sunken}" VerticalAlignment="Center">
                            <Border x:Name="ThemFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"
                                    Background="{StaticResource Accent}"/>
                        </Border>
                    </Grid>

                    <Border x:Name="ProblemPanel" Style="{StaticResource CautionPanel}" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource CautionInk}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <StackPanel x:Name="RecordingClock" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,0,0,10" Visibility="Collapsed">
                        <!-- Red is reserved for recording, everywhere in Teezy. -->
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Record}" VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="ElapsedText" Style="{StaticResource StatNumber}"/>
                    </StackPanel>
                    <!-- Primary to start. The code-behind swaps the label while recording. -->
                    <Button x:Name="RecordButton" Style="{StaticResource Primary}" Content="Start recording"
                            Click="OnRecord" MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transcription in progress -->
        <Border x:Name="WorkCard" Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock x:Name="WorkTitle" Style="{StaticResource H2}" Text="Transcribing"/>
                    <Border x:Name="WorkTrack" Height="6" CornerRadius="2" Margin="0,12,0,0"
                            Background="{StaticResource Sunken}">
                        <Border x:Name="WorkFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"
                                Background="{StaticResource Accent}"/>
                    </Border>
                    <TextBlock x:Name="WorkDetail" Margin="0,8,0,0" FontSize="12"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Stop" Style="{StaticResource Secondary}"
                        VerticalAlignment="Center" Click="OnCancelTranscription"/>
            </Grid>
        </Border>

        <!-- Past meetings -->
        <Border Grid.Row="3" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="RECORDED" Style="{StaticResource SectionLabel}"/>
                <!-- Said where the button is, not in a dialog after it: Summarise is the one thing on
                     this page that sends a meeting anywhere. -->
                <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,8"
                           Text="Recording and transcripts stay on this computer. Summarise sends that meeting's transcript to Claude, using your own Anthropic API key."/>
                <Border x:Name="ListCard" Style="{StaticResource ListCard}">
                    <ItemsControl x:Name="MeetingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Padding="12,8" Background="Transparent"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular"
                                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Transcribe" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding TranscribeVisibility}" Click="OnTranscribe"/>
                                            <Button Content="Transcribe again" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    ToolTip="Make the transcript again from the recording this computer kept"
                                                    Visibility="{Binding RedoVisibility}" Click="OnTranscribeAgain"/>
                                            <Button Content="Name the voices" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding RenameVisibility}" Click="OnNameVoices"/>
                                            <Button Content="Summarise" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding SummariseVisibility}" Click="OnSummarise"/>
                                            <Button Content="Notes PDF" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding NotesVisibility}" Click="OnNotes"/>
                                            <Button Content="Transcript" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding TranscriptVisibility}" Click="OnOpen"/>
                                            <Button Content="Copy" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding TranscriptVisibility}" Click="OnCopy"/>
                                            <Button Content="Delete" Style="{StaticResource Quiet}" Tag="{Binding}"
                                                    Visibility="{Binding DeleteVisibility}" Click="OnDelete"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- The first row has no line above it: the card's edge is enough. -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Visibility="Collapsed"
                           Text="Nothing recorded yet. Start recording when a meeting begins and stop when it ends."/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
