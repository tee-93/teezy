<Window x:Class="Teezy.App.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <!--
      One message, read without leaving Teezy. Deliberately a reader and not a client: there is
      no reply, no forward and no mark-as-read, because the permissions to do any of those were
      never asked for.

      A real window rather than a panel over the page: a message is something you read and then
      dismiss, not a mode the dashboard enters.
    -->
    <Border Padding="20">
        <StackPanel>
            <Grid>
                <TextBlock x:Name="Mailbox" Style="{StaticResource SectionLabel}" Margin="0"/>
                <TextBlock x:Name="When" HorizontalAlignment="Right" FontSize="12"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{StaticResource Muted}"/>
            </Grid>

            <TextBlock x:Name="Subject" Style="{StaticResource H2}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="Who" Foreground="{StaticResource Body}"/>

                <!-- The address next to the name it claims. A display name is chosen by whoever
                     sent the message; the address is the part that is hard to fake. -->
                <TextBlock x:Name="Address" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Background="{StaticResource Sunken}" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                <TextBlock x:Name="Preview" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource Body}"/>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Text="A preview only, and read-only — TeezyFlow cannot reply, delete, or mark this as read."/>
                <Button Grid.Column="1" Content="Close" Style="{StaticResource Secondary}" Click="OnClose"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
