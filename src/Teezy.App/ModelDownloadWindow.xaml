<Window x:Class="Teezy.App.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setting up TeezyFlow" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="24,20,24,20">

        <!-- The wordmark. This window is the first thing a new user sees. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Path Data="{StaticResource MarkGeometry}" Fill="{StaticResource Accent}" Stretch="Uniform"
                  Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="teezy" Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                       FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="22"/>
            <TextBlock Text="flow" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                       FontFamily="{StaticResource BrandFont}" FontWeight="Bold" FontSize="22"/>
        </StackPanel>

        <TextBlock Text="Almost there" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Lede}" Margin="0,4,0,0"
                   Text="TeezyFlow is downloading its speech model — about 661 MB. This happens once. Afterwards dictation runs entirely on this machine, with no network access at all."/>

        <!-- Raised, not Sunken: this window's ground is Paper, which Sunken is identical to. -->
        <Border x:Name="BarTrack" Height="6" CornerRadius="2" Background="{StaticResource Raised}"
                Margin="0,18,0,0">
            <Border x:Name="BarFill" HorizontalAlignment="Left" CornerRadius="2" Width="0"
                    Background="{StaticResource Accent}"/>
        </Border>

        <Grid Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"
                       Typography.NumeralAlignment="Tabular"
                       Text="Starting…" HorizontalAlignment="Left"/>
            <TextBlock x:Name="PercentText" Foreground="{StaticResource Muted}" FontSize="12"
                       Typography.NumeralAlignment="Tabular"
                       Text="0%" HorizontalAlignment="Right"/>
        </Grid>

        <Border x:Name="ErrorBox" Style="{StaticResource CautionPanel}"
                Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                       Foreground="{StaticResource CautionInk}" FontSize="12"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource Primary}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="OnRetry"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Secondary}"
                    Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
