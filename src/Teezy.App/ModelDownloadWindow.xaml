<Window x:Class="Teezy.App.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setting up Teezy" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="30,26,30,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <!-- The full logo, not the glyph. This window is the first thing a new user
                 sees and there is room for the mark to be itself. -->
            <Image Source="{StaticResource MarkImage}" Height="52" Stretch="Uniform"
                   VerticalAlignment="Center"/>
            <TextBlock Text="Almost there" Style="{StaticResource Display}" FontSize="24"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Lede}"
                   Text="Teezy is downloading its speech model — about 661 MB. This happens once. Afterwards dictation runs entirely on this machine, with no network access at all."/>

        <Border x:Name="BarTrack" Height="7" CornerRadius="4" Background="{StaticResource Hairline}" Margin="0,22,0,0">
            <Border x:Name="BarFill" HorizontalAlignment="Left" CornerRadius="4" Width="0"
                    Background="{StaticResource Accent}"/>
        </Border>

        <Grid Margin="0,11,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="Starting…" HorizontalAlignment="Left"/>
            <TextBlock x:Name="PercentText" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="0%" HorizontalAlignment="Right"/>
        </Grid>

        <Border x:Name="ErrorBox" Style="{StaticResource CautionPanel}"
                Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                       Foreground="{StaticResource CautionInk}" FontSize="12"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource Primary}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="OnRetry"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Secondary}"
                    Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
