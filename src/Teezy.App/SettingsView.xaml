<UserControl x:Class="Teezy.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel Margin="38,30,38,36" MaxWidth="760">

            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Lede}" Margin="0,6,0,0"
                       Text="Everything runs on this machine. Nothing you say is sent anywhere."/>

            <!-- Hero: the hotkey, because it is the only setting most people ever change. -->
            <Border Style="{StaticResource CardPanel}" Margin="0,24,0,0" Padding="26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource Accent}">
                            <Path Data="{StaticResource MarkGeometry}" Fill="White" Stretch="Uniform"
                                  Width="23" Height="23"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Push to talk" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="HotkeyDisplay" Style="{StaticResource Display}" FontSize="26"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="Hold every key together, speak, then let go."/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="KeyPicker" Grid.Column="0" SelectionChanged="OnHotkeyPreset"/>
                        <Button x:Name="RecordButton" Grid.Column="1" Content="Record my own"
                                Style="{StaticResource Secondary}" Margin="10,0,0,0" Height="38"
                                Click="OnRecordHotkey"/>
                    </Grid>

                    <Border x:Name="HotkeyWarning" Style="{StaticResource CautionPanel}"
                            Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="HotkeyWarningText" TextWrapping="Wrap"
                                   Foreground="{StaticResource CautionInk}" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Microphone. Directly under the hotkey because between them they are the whole
                 input path, and a wrong device here looks exactly like a bad recogniser. -->
            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Microphone" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Windows picks one for you, and on a laptop that is often the built-in array — which hears the room as well as you, and transcribes it. If dictation keeps mishearing you, this is the first thing to check."/>

                    <ComboBox x:Name="MicPicker" Margin="0,14,0,0"
                              SelectionChanged="OnMicrophoneChanged"/>

                    <TextBlock x:Name="MicInUse" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                    <Border x:Name="MicWarning" Style="{StaticResource CautionPanel}"
                            Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock x:Name="MicWarningText" TextWrapping="Wrap"
                                   Foreground="{StaticResource CautionInk}" FontSize="12"/>
                    </Border>

                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                    <TextBlock Text="CHECK IT IS HEARING YOU" Style="{StaticResource SectionLabel}"
                               Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="Opens the microphone and shows what it is picking up. Speak at your normal dictating volume — the bar should reach halfway and beyond."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MicTestButton" Grid.Column="0" Content="Start test"
                                Style="{StaticResource Secondary}" Click="OnTestMicrophone"/>

                        <Border x:Name="MicLevelTrack" Grid.Column="1" Height="10" CornerRadius="5"
                                Background="{StaticResource Sunken}" BorderThickness="1"
                                BorderBrush="{StaticResource Hairline}"
                                Margin="14,0,0,0" VerticalAlignment="Center">
                            <!-- Sized in code-behind: a fill needs the track's measured width,
                                 which only exists after layout. -->
                            <Border x:Name="MicLevelFill" Width="0" CornerRadius="5"
                                    HorizontalAlignment="Left" Background="{StaticResource Accent}"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="MicTestStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource H2}" Margin="0,0,0,4"/>

                    <StackPanel x:Name="Switches">
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="Start Teezy when I sign in" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="AutostartNote" Style="{StaticResource Hint}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="OnAutostartChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,15,0,0"/>

                        <Grid Margin="0,15,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="Tidy up what I say" Foreground="{StaticResource Ink}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Removes ums and ahs, fixes spacing, honours “scratch that”. Your dictionary is applied either way."/>
                            </StackPanel>
                            <CheckBox x:Name="CleanupBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,15,0,0"/>

                        <Grid Margin="0,15,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="Show the level meter" Foreground="{StaticResource Ink}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A small bar at the bottom of the screen while you are talking."/>
                            </StackPanel>
                            <CheckBox x:Name="HudBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,15,0,0"/>

                        <Grid Margin="0,15,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                <TextBlock Text="Play a tone" Foreground="{StaticResource Ink}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A short rising note when recording opens, falling when it closes."/>
                            </StackPanel>
                            <CheckBox x:Name="SoundBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnChanged"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Smarter cleanup. Off by default: switching it on ends the offline guarantee. -->
            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                            <TextBlock Text="Smarter cleanup with Claude" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A second pass that fixes grammar, formats lists and honours spoken corrections. Needs your own Anthropic API key, and sends each transcript to the API."/>
                        </StackPanel>
                        <CheckBox x:Name="LlmBox" Style="{StaticResource Switch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Click="OnLlmToggled"/>
                    </Grid>

                    <StackPanel x:Name="LlmDetail" Visibility="Collapsed">
                        <Border Style="{StaticResource CautionPanel}" Margin="0,14,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource CautionInk}" FontSize="12"
                                       Text="This is the one thing in Teezy that leaves your machine. Transcripts are sent to the Anthropic API, billed to your own account — a Claude Pro or Max subscription does not cover it. Roughly $0.60 a month at 400 dictations, and it adds about a second to each one."/>
                        </Border>

                        <TextBlock Text="API KEY" Style="{StaticResource SectionLabel}" Margin="0,16,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- PasswordBox, not TextBox: the key must not be shoulder-readable,
                                 and WPF never puts its contents in the visual tree as text. -->
                            <Border Grid.Column="0" Background="{StaticResource Sunken}" CornerRadius="9"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1" Height="38">
                                <PasswordBox x:Name="ApiKeyBox" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" Margin="12,0"
                                             PasswordChar="•" FontSize="13"
                                             PasswordChanged="OnApiKeyTyped"/>
                            </Border>

                            <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Save key"
                                    Style="{StaticResource Primary}" Margin="10,0,0,0" Height="38"
                                    IsEnabled="False" Click="OnSaveApiKey"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="0"
                                       HorizontalAlignment="Left"/>
                            <Button x:Name="ForgetKeyButton" Content="Forget key" Style="{StaticResource Quiet}"
                                    HorizontalAlignment="Right" Visibility="Collapsed" Click="OnForgetApiKey"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Create a key at console.anthropic.com. It is encrypted for your Windows account and never written to settings.json."/>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                        <Grid Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                                <TextBlock Text="Model" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="ModelCost" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="LlmModelPicker" Width="180" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" SelectionChanged="OnLlmModelChanged"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                                <TextBlock Text="Writing style" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="StyleHint" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="StylePicker" Width="180" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" SelectionChanged="OnStyleChanged"/>
                        </Grid>

                        <TextBlock Text="AND ALWAYS" Style="{StaticResource SectionLabel}"
                                   Margin="0,16,0,7"/>
                        <Border Background="{StaticResource Sunken}" CornerRadius="9"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                            <TextBox x:Name="StyleInstructionBox" BorderThickness="0"
                                     Background="Transparent" MinHeight="34" Padding="12,8"
                                     FontSize="13" TextWrapping="Wrap" AcceptsReturn="False"
                                     LostFocus="OnStyleInstructionChanged"/>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="One line of your own, added to every request — “British spelling”, “never use em dashes”. It rides on every utterance, so keep it short."/>

                        <Grid Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                                <TextBlock Text="Give up after" Foreground="{StaticResource Ink}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Past this, Teezy types the offline result instead. Text appearing beats a slower tidy-up."/>
                            </StackPanel>
                            <ComboBox x:Name="LlmTimeoutPicker" Width="180" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" SelectionChanged="OnChanged"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="TestButton" Content="Test it" Style="{StaticResource Secondary}"
                                    Click="OnTestLlm"/>
                            <TextBlock x:Name="TestResult" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" MaxWidth="440"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                        <TextBlock Text="PER-APP RULES" Style="{StaticResource SectionLabel}"
                                   Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="A style that applies only where the text is going, so an email and a chat message do not have to share one setting. First match wins; anything with no rule uses the style above."/>

                        <StackPanel x:Name="RuleRows" Margin="0,10,0,0"/>

                        <TextBlock x:Name="NoRules" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="No rules yet. Add one below — the list offers the apps you have already dictated into."/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="NewRuleApp" Grid.Column="0" IsEditable="True"
                                      VerticalAlignment="Center"/>
                            <Button x:Name="AddRuleButton" Grid.Column="1" Content="Add rule"
                                    Style="{StaticResource Secondary}" Margin="10,0,0,0"
                                    Click="OnAddRule"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Speech model -->
            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Speech model" Style="{StaticResource H2}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ModelDot" Width="9" Height="9" VerticalAlignment="Center"
                                 Margin="0,0,9,0" Fill="{StaticResource Faint}"/>
                        <TextBlock x:Name="ModelStatus" Foreground="{StaticResource Ink}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ModelPath" Style="{StaticResource Hint}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="18,6,0,0"/>

                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                            <TextBlock Text="Inference threads" Foreground="{StaticResource Ink}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Four measured fastest on this machine; eight measured slower. More is not better here."/>
                        </StackPanel>
                        <ComboBox x:Name="ThreadPicker" Width="86" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" SelectionChanged="OnChanged"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                            <TextBlock Text="Decoding" Foreground="{StaticResource Ink}"/>
                            <TextBlock x:Name="DecodingHint" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <ComboBox x:Name="DecodingPicker" Width="180" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" SelectionChanged="OnDecodingChanged"/>
                    </Grid>

                    <!-- Only meaningful under beam search, so hidden under greedy rather than
                         shown greyed out next to a setting that would do nothing. -->
                    <StackPanel x:Name="BeamOptions" Visibility="Collapsed">
                        <Grid Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,120,0">
                                <TextBlock Text="Candidates kept" Foreground="{StaticResource Ink}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="How many transcripts beam search weighs before choosing. More is slower and rarely better past four."/>
                            </StackPanel>
                            <ComboBox x:Name="BeamPicker" Width="86" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" SelectionChanged="OnChanged"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,190,0">
                                <TextBlock Text="Hint strength" Foreground="{StaticResource Ink}"/>
                                <TextBlock x:Name="HotwordHint" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ComboBox x:Name="HotwordPicker" Width="180" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" SelectionChanged="OnChanged"/>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource CautionPanel}" Margin="0,16,0,0">
                        <TextBlock Foreground="{StaticResource CautionInk}" TextWrapping="Wrap"
                                   Text="Decoding settings are compiled into the recogniser, so they take effect when Teezy next starts."/>
                    </Border>

                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18,0,0"/>

                    <TextBlock Text="TUNE FOR THIS MACHINE" Style="{StaticResource SectionLabel}"
                               Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Times the recogniser at several thread counts and keeps the fastest. Dictation pauses while it runs, and it takes under a minute."/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckMachineButton" Content="Check this machine"
                                Style="{StaticResource Secondary}" Click="OnCheckMachine"/>
                        <TextBlock x:Name="CheckProgress" Style="{StaticResource Hint}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="CheckResult" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardPanel}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="AboutVersion" Foreground="{StaticResource Body}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Speech by NVIDIA Parakeet TDT 0.6B, converted to ONNX and quantised to int8 by csukuangfj, run through sherpa-onnx. Model weights are CC-BY-4.0; sherpa-onnx is Apache-2.0; ONNX Runtime and NAudio are MIT."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open data folder" Style="{StaticResource Secondary}"
                                Click="OnOpenDataFolder"/>
                        <Button x:Name="QuitButton" Content="Quit Teezy" Style="{StaticResource Quiet}"
                                Margin="8,0,0,0" Click="OnQuit"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
