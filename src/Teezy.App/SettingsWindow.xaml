<Window x:Class="Teezy.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teezy" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFBFBFD"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF6E6E73"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FF8E8E93"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE3E3E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22">

        <TextBlock Text="Teezy" FontSize="22" FontWeight="SemiBold" Foreground="#FF1C1C1E"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Hint}" Margin="0,2,0,18"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PUSH TO TALK" Style="{StaticResource Heading}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="KeyPicker" Grid.Column="0" SelectionChanged="OnHotkeyPreset"/>
                    <Button x:Name="RecordButton" Grid.Column="1" Content="Record…" Margin="8,0,0,0"
                            Padding="14,5" Click="OnRecordHotkey"/>
                </Grid>

                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}"
                           Text="Hold every key together, speak, release."/>

                <!-- Real, reproducible nuisances rather than restrictions: it is the user's
                     keyboard, and someone who has already turned Filter Keys off should not
                     be stopped from using Shift. -->
                <Border x:Name="HotkeyWarning" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10"
                        Background="#FFF9EC" BorderBrush="#F3E3B8" BorderThickness="1" CornerRadius="8">
                    <TextBlock x:Name="HotkeyWarningText" TextWrapping="Wrap"
                               Foreground="#8A6100" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="BEHAVIOUR" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="AutostartBox" Content="Start Teezy when I sign in" Click="OnAutostartChanged"/>
                <TextBlock x:Name="AutostartNote" Style="{StaticResource Hint}" Visibility="Collapsed"
                           Margin="24,-6,0,9"/>
                <CheckBox x:Name="CleanupBox" Content="Clean up filler words and spacing" Click="OnChanged"/>
                <CheckBox x:Name="HudBox"     Content="Show the level meter while recording" Click="OnChanged"/>
                <CheckBox x:Name="SoundBox"   Content="Play a tone when recording starts and stops" Click="OnChanged"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Your personal dictionary is always applied, even with cleanup off — biasing only improves the odds, so the correction pass is what actually guarantees a spelling."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="SPEECH MODEL" Style="{StaticResource Heading}"/>
                <TextBlock x:Name="ModelStatus" TextWrapping="Wrap" Foreground="#FF1C1C1E"/>
                <TextBlock x:Name="ModelPath" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Threads" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="ThreadPicker" Width="70" SelectionChanged="OnChanged"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Four measured fastest on this machine; eight measured slower. More is not better here."/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Edit dictionary…" Padding="14,7" Margin="0,0,8,0" Click="OnEditDictionary"/>
            <Button Content="Close" Padding="20,7" Click="OnClose" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
