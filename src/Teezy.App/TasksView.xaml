<UserControl x:Class="Teezy.App.TasksView" xmlns:local="clr-namespace:Teezy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      TeezyFlow's own task list. The list is on the left, grouped by when things are due; the task
      chosen opens on the right with its dates, notes, follow-up chain and an email box. Rows and
      the detail's changing parts are built in code (see TasksView.xaml.cs).
    -->
    <!-- Emails dragged from Outlook land anywhere on the page: on a task to add to it, elsewhere
         to make one. Preview events, so a drop on a text box is not swallowed as plain text. -->
    <Grid Margin="28,24,28,24" Background="Transparent" AllowDrop="True"
          PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== the list ============================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Tasks" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Lede" Style="{StaticResource Lede}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Quick add: a date, a time and a #category can go at the end. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <Border Style="{StaticResource FieldBox}" Height="36">
                    <Grid>
                        <TextBlock x:Name="AddPlaceholder" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Add a task — e.g. Chase Cessnock quote fri 2pm #Quotes — or drag an email here"/>
                        <TextBox x:Name="AddBox" Style="{StaticResource BareText}"
                                 TextChanged="OnAddTyped" KeyDown="OnAddKey"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="AddPreview" Style="{StaticResource FormHint}" Margin="2,4,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Category filter, built from the categories in use. -->
            <WrapPanel x:Name="Filters" Grid.Row="2" Margin="0,0,0,12"/>

            <!-- Shown after closing, so a slip is one click to undo. -->
            <Border x:Name="UndoBar" Grid.Row="3" Style="{StaticResource CautionPanel}" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UndoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource CautionInk}"/>
                    <Button Grid.Column="1" Content="Undo" Style="{StaticResource Quiet}" Click="OnUndo"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="EmptyState" Style="{StaticResource CardPanel}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Margin="0,24">
                            <Image Source="{StaticResource MarkImage}" Width="36" Height="36" Margin="0,0,0,12"/>
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextAlignment="Center"
                                       MaxWidth="460" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="Groups"/>

                    <Button x:Name="ClosedToggle" Style="{StaticResource Quiet}" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Click="OnToggleClosed"/>
                    <StackPanel x:Name="ClosedList" Visibility="Collapsed" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================== the chosen task ============================== -->
        <!--
          Top to bottom in the order a task is worked: what and when, closing it, the history
          (chain and notes), then the email and the AI help, each folded away until wanted.
        -->
        <Border x:Name="Detail" Grid.Column="1" Width="440" Margin="20,0,0,0" Style="{StaticResource CardPanel}"
                Padding="0" Visibility="Collapsed">
            <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,18">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailState" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Close panel" Style="{StaticResource Quiet}" Click="OnDeselect"/>
                    </Grid>

                    <TextBox x:Name="TitleBox" Style="{StaticResource Field}" Height="Auto" MinHeight="34"
                             TextWrapping="Wrap" Padding="8,6" FontSize="15" FontWeight="SemiBold"
                             LostKeyboardFocus="OnTitleCommit" KeyDown="OnTitleKey"/>
                    <TextBlock x:Name="DetailCreated" Style="{StaticResource FormHint}" Margin="2,6,0,0"/>

                    <!-- When, and what kind. -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Due" Style="{StaticResource FormHint}" Margin="0,0,0,4"/>
                        <local:DateTimeField x:Name="DueField" Grid.Row="1" Placeholder="No due date"/>

                        <TextBlock Grid.Column="2" Text="Remind me" Style="{StaticResource FormHint}" Margin="0,0,0,4"/>
                        <local:DateTimeField x:Name="RemindField" Grid.Row="1" Grid.Column="2" Placeholder="No reminder"
                                             TimeRequired="True"/>

                        <TextBlock Grid.Row="3" Text="Category" Style="{StaticResource FormHint}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryPicker" Grid.Row="4" SelectionChanged="OnCategoryChosen"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="Manage categories…" Style="{StaticResource Quiet}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnManageCategories"/>
                    </Grid>

                    <!-- Closing. -->
                    <StackPanel x:Name="OpenActions" Margin="0,18,0,0">
                        <Button Content="Close task" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="OnCloseTask"/>
                        <TextBlock Text="CLOSE AND FOLLOW UP" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                        <WrapPanel x:Name="FollowUpChoices"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <local:DateTimeField x:Name="FollowUpDay" Placeholder="Another day…"/>
                            <Button x:Name="FollowUpThen" Grid.Column="1" Content="Follow up then" Style="{StaticResource Secondary}"
                                    Margin="8,0,0,0" IsEnabled="False" Click="OnFollowUpOn"/>
                        </Grid>
                    </StackPanel>
                    <Button x:Name="ReopenButton" Content="Reopen" Style="{StaticResource Secondary}" HorizontalAlignment="Left"
                            Margin="0,18,0,0" Click="OnReopen" Visibility="Collapsed"/>

                    <!-- The follow-up chain, when there is one. -->
                    <StackPanel x:Name="ChainSection" Visibility="Collapsed">
                        <TextBlock Text="THE CHAIN" Style="{StaticResource SectionLabel}" Margin="0,22,0,6"/>
                        <Border Style="{StaticResource ListCard}">
                            <StackPanel x:Name="ChainList"/>
                        </Border>
                    </StackPanel>

                    <!-- Notes: a running timeline, newest first, for reviews. -->
                    <TextBlock x:Name="NotesLabel" Text="NOTES" Style="{StaticResource SectionLabel}" Margin="0,22,0,6"/>
                    <Grid>
                        <TextBox x:Name="NoteBox" Style="{StaticResource Field}" Height="Auto" MinHeight="54"
                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" VerticalContentAlignment="Top"
                                 KeyDown="OnNoteKey" TextChanged="OnNoteTyped"/>
                        <TextBlock x:Name="NotePlaceholder" Style="{StaticResource Hint}" Margin="10,7,0,0"
                                   IsHitTestVisible="False" Text="Add a note — Ctrl+Enter to save"/>
                    </Grid>
                    <Button x:Name="AddNoteButton" Content="Add note" Style="{StaticResource Secondary}" HorizontalAlignment="Left"
                            Margin="0,6,0,10" IsEnabled="False" Click="OnAddNote"/>
                    <StackPanel x:Name="NotesList"/>

                    <!-- The email: folded away; opened in its own window to read. -->
                    <Border Style="{StaticResource FormRows}" Margin="0,18,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource FormRowFirst}" Padding="12,10">
                                <ToggleButton x:Name="EmailToggle" Style="{StaticResource SectionToggle}"
                                              Checked="OnEmailToggled" Unchecked="OnEmailToggled">
                                    <StackPanel>
                                        <TextBlock x:Name="EmailHeader" Text="EMAIL" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <TextBlock x:Name="EmailSummary" Style="{StaticResource FormHint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                            <Border x:Name="EmailBody" Style="{StaticResource FormRow}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel x:Name="EmailList"/>
                                    <Button x:Name="PasteEmailButton" Content="Paste an email…" Style="{StaticResource Quiet}"
                                            HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnShowPasteEmail"/>
                                    <StackPanel x:Name="PasteEmailPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <TextBox x:Name="PasteEmailBox" Style="{StaticResource Field}" Height="Auto" MinHeight="90" MaxHeight="220"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="Copy the email from Outlook and paste it here, or drag it onto the task"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Attach" Style="{StaticResource Primary}" Click="OnAttachPasted"/>
                                            <Button Content="Cancel" Style="{StaticResource Quiet}" Margin="6,0,0,0" Click="OnCancelPaste"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- The AI: folded away; the answer is editable and kept on the task. -->
                    <Border x:Name="AiSection" Style="{StaticResource FormRows}" Margin="0,10,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource FormRowFirst}" Padding="12,10">
                                <ToggleButton x:Name="AiToggle" Style="{StaticResource SectionToggle}"
                                              Checked="OnAiToggled" Unchecked="OnAiToggled">
                                    <StackPanel>
                                        <TextBlock Text="NEXT STEPS AND REPLY" Style="{StaticResource SectionLabel}" Margin="0"/>
                                        <TextBlock x:Name="AiSummary" Style="{StaticResource FormHint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                            <Border x:Name="AiBody" Style="{StaticResource FormRow}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="AiSource" Style="{StaticResource FormHint}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="AiEmailPicker" Margin="0,0,0,8" Visibility="Collapsed"/>
                                    <Grid>
                                        <TextBox x:Name="SteerBox" Style="{StaticResource Field}" TextChanged="OnSteerTyped"/>
                                        <TextBlock x:Name="SteerPlaceholder" Style="{StaticResource Hint}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Text="Optional: how to answer — “yes, but not before Friday”"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="NextStepsButton" Content="Next steps" Style="{StaticResource Secondary}" Click="OnNextSteps"/>
                                        <Button x:Name="DraftReplyButton" Content="Draft reply" Style="{StaticResource Secondary}"
                                                Margin="8,0,0,0" Click="OnDraftReply"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AiStatus" Style="{StaticResource FormHint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <StackPanel x:Name="AdvicePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBox x:Name="AdviceBox" Style="{StaticResource Field}" Height="Auto" MinHeight="120"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" VerticalContentAlignment="Top"
                                                 LostKeyboardFocus="OnAdviceEdited"
                                                 ToolTip="Edit freely — it is kept with the task"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="CopyAdviceButton" Content="Copy" Style="{StaticResource Primary}" Click="OnCopyAdvice"/>
                                            <Button x:Name="SaveAdviceButton" Content="Save to notes" Style="{StaticResource Secondary}"
                                                    Margin="8,0,0,0" Click="OnSaveAdvice"/>
                                            <Button Content="Clear" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="OnClearAdvice"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="AiNote" Style="{StaticResource FormHint}" Margin="0,10,0,0"
                                               Text="Sends the email and the task's title to Claude on your own Anthropic key, only when you press a button. Check your employer is happy with work email going to an outside AI service."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button x:Name="DeleteButton" Content="Delete task" Style="{StaticResource Quiet}" HorizontalAlignment="Left"
                            Margin="0,22,0,0" Foreground="{StaticResource Danger}" Click="OnDelete"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
