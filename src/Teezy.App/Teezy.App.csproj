<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- Both shipping targets. A RuntimeIdentifier is mandatory, not a nicety: without one
         the native speech libraries land in runtimes/<rid>/native/ and P/Invoke fails at
         runtime with DllNotFoundException. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Default for a bare `dotnet run` on this machine; `-r` overrides it when publishing. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>

    <UseWPF>true</UseWPF>
    <!-- For the tray icon only: WPF still has no NotifyIcon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows reads the icon from the PE file, not from the running process. Without this,
         Explorer, the Start Menu, Alt-Tab and taskbar pinning all show the generic exe icon
         no matter what the app draws at runtime. Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>Teezy.ico</ApplicationIcon>
    <AssemblyName>Teezy</AssemblyName>
    <RootNamespace>Teezy.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinForms is referenced only for the tray icon, but its implicit global usings pull
         in System.Drawing and System.Windows.Forms, which collide with WPF on Application,
         Rectangle, Color, Size and Point. Explicit usings are clearer than qualifying each. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teezy.Core\Teezy.Core.csproj" />
    <ProjectReference Include="..\Teezy.Speech\Teezy.Speech.csproj" />
    <ProjectReference Include="..\Teezy.Cleanup\Teezy.Cleanup.csproj" />
    <ProjectReference Include="..\Teezy.Platform.Windows\Teezy.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named per RID rather than left to the base package to infer. Verified by reading the
         PE header of the DLLs a published x64 build actually loads: an ARM64 native library
         inside an x64 exe would fail at load with BadImageFormatException, which is a
         miserable thing to discover on someone else's machine. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64"
                      Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>
</Project>
