<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      The whole design system. Views must not contain literal colours, sizes or radii: if a
      component needs a value that is not here, add it here.

      The direction is warm paper and ink against a cool, saturated accent — a serif for
      display type, a humanist sans for everything else. Quiet enough to live in the tray all
      day without competing with whatever the user is actually working on.

      THE ACCENT IS THE LOGO'S. Electric blue over navy, taken from the mark rather than
      chosen separately, so the app and its own logo cannot drift apart. It is bolder than
      the muted blue it replaced; the warmth now lives entirely in the paper and the ink,
      which is what keeps the pairing from shouting.

      RED IS RESERVED. It means recording and appears nowhere else, which is why the accent
      is a blue: any warm accent would compete with the one signal that must read instantly.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Paper"      Color="#FCFAF7"/>
    <SolidColorBrush x:Key="Card"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Rail"       Color="#F5F1EA"/>
    <SolidColorBrush x:Key="Sunken"     Color="#F7F4EF"/>
    <SolidColorBrush x:Key="Hairline"   Color="#E9E4DC"/>
    <SolidColorBrush x:Key="Hover"      Color="#F2EEE7"/>

    <!-- Type -->
    <SolidColorBrush x:Key="Ink"        Color="#1B1A18"/>
    <SolidColorBrush x:Key="Body"       Color="#45423D"/>
    <SolidColorBrush x:Key="Muted"      Color="#7A756E"/>
    <SolidColorBrush x:Key="Faint"      Color="#A8A29A"/>

    <!--
      Accent, taken from the mark rather than chosen beside it. Accent is the blue the sound
      waves start in and AccentInk is the navy of the speech bubble; the other two are derived.

      Accent carries white text at 6.4:1 and AccentInk sits on AccentSoft at 14.3:1, so both
      pairings clear AA for body text rather than only for the large type they mostly carry.
    -->
    <SolidColorBrush x:Key="Accent"     Color="#2147F5"/>
    <SolidColorBrush x:Key="AccentDeep" Color="#1633C4"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E9EEFF"/>
    <SolidColorBrush x:Key="AccentInk"  Color="#081A4E"/>

    <!--
      Mark-only colours. None of these may become UI colours, for two separate reasons.

      MarkWaveEnd is the far end of the wave gradient and manages only 3.6:1 against white —
      fine as one end of a ramp across a stroke, and a quiet accessibility failure the moment
      anything sets text on it. MarkSparkle is the single warm note in the brand; promoting it
      would stand a warm colour next to the recording red, which is the whole thing the
      palette is arranged to prevent.

      MarkReversed is the ink the logo files use on dark grounds.
    -->
    <Color x:Key="MarkWaveStart">#2147F5</Color>
    <Color x:Key="MarkWaveEnd">#1186FF</Color>
    <SolidColorBrush x:Key="MarkCursor"   Color="#1E63FF"/>
    <SolidColorBrush x:Key="MarkSparkle"  Color="#F6B32B"/>
    <SolidColorBrush x:Key="MarkReversed" Color="#F8FAFF"/>

    <!-- Recording. Nothing else in the app is this colour. -->
    <SolidColorBrush x:Key="Record"     Color="#E5484D"/>

    <!-- The floating meter. A warm near-black rather than a cold one, so it belongs to the
         same family as the paper it sits over. -->
    <SolidColorBrush x:Key="HudPill"   Color="#F21F1D1A"/>
    <SolidColorBrush x:Key="HudEdge"   Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="HudText"   Color="#EFEBE4"/>
    <SolidColorBrush x:Key="HudMeter"  Color="#EFEBE4"/>

    <!-- Caution, for hotkey and dictionary warnings. -->
    <SolidColorBrush x:Key="CautionBg"     Color="#FDF6E7"/>
    <SolidColorBrush x:Key="CautionBorder" Color="#EFE0BC"/>
    <SolidColorBrush x:Key="CautionInk"    Color="#7A5A17"/>

    <!--
      ============================== The mark ==============================

      The Teezy mark: speech flowing into a text bubble, cleaned up. Two versions, because
      one drawing cannot serve both a 46 px card and a 16 px tray icon.

      MarkImage is the logo as drawn, on the 1000x1000 grid of Logo\teezy-icon.svg, which
      stays the source of truth for the artwork. Coordinates are copied across unchanged so
      the two can be diffed by eye.

      MarkGeometry is the small-size glyph — see the note above it.
    -->

    <LinearGradientBrush x:Key="MarkWave" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource MarkWaveStart}" Offset="0"/>
        <GradientStop Color="{StaticResource MarkWaveEnd}"   Offset="1"/>
    </LinearGradientBrush>

    <DrawingImage x:Key="MarkImage">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- Speech bubble. Open on the left between y=315 and y=670, which is the
                     gap the voice flows in through. -->
                <GeometryDrawing Geometry="M385,180 H690 Q800,180 800,290 V690 Q800,800 690,800 H420 L300,870 V670">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource AccentInk}" Thickness="44"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M300,315 V270 Q300,180 385,180">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource AccentInk}" Thickness="44"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- Flowing voice. Each wave carries the gradient across its own bounding
                     box, exactly as the SVG's objectBoundingBox units do. -->
                <GeometryDrawing Brush="{StaticResource MarkWave}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="105,360" RadiusX="18" RadiusY="18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MarkWave}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="70,495" RadiusX="18" RadiusY="18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MarkWave}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="130,625" RadiusX="18" RadiusY="18"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Geometry="M155,370 C235,390 300,390 365,355 C410,330 450,323 510,323">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MarkWave}" Thickness="34"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M130,495 C225,505 290,535 380,500 C425,482 465,475 525,475">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MarkWave}" Thickness="34"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M165,625 C255,635 320,665 390,630 C440,605 480,600 530,600">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MarkWave}" Thickness="34"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>

                <!-- The text it lands as -->
                <GeometryDrawing Brush="{StaticResource AccentInk}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="575,455,95,28"  RadiusX="14" RadiusY="14"/>
                            <RectangleGeometry Rect="575,520,110,28" RadiusX="14" RadiusY="14"/>
                            <RectangleGeometry Rect="575,585,82,28"  RadiusX="14" RadiusY="14"/>
                            <RectangleGeometry Rect="715,455,38,28"  RadiusX="14" RadiusY="14"/>
                            <RectangleGeometry Rect="715,520,38,28"  RadiusX="14" RadiusY="14"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Text cursor -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MarkCursor}" Thickness="18"
                             StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="690,390" EndPoint="690,655"/>
                            <LineGeometry StartPoint="672,390" EndPoint="708,390"/>
                            <LineGeometry StartPoint="672,655" EndPoint="708,655"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Clean-up sparkle -->
                <GeometryDrawing Brush="{StaticResource MarkSparkle}"
                                 Geometry="M535,295 C548,331 563,346 600,358 C563,371 548,386 535,422 C522,386 507,371 470,358 C507,346 522,331 535,295 Z"/>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
      The mark at small sizes, on a 100x100 grid, as one monochrome path so the tray can tint
      it per state and the .ico can render it at 16 px.

      IT IS NOT A SHRUNK MarkImage, and must not become one. At 16 px the bubble's 44-unit
      stroke lands on two thirds of a pixel, the three waves collapse into each other, and
      the sparkle and cursor disappear entirely — the whole thing greys into a smudge. So the
      bubble becomes a silhouette, the text lines are knocked out of it with EvenOdd, and the
      waves are dropped rather than rendered as mush. What survives is the silhouette, which
      is the half of the mark that reads at any size.
    -->
    <PathGeometry x:Key="MarkGeometry" FillRule="EvenOdd"
                  Figures="M30,14 H70 A16,16 0 0 1 86,30 V58 A16,16 0 0 1 70,74 H46 L30,90 V74 A16,16 0 0 1 14,58 V30 A16,16 0 0 1 30,14 Z
                           M32,30 H60 A5,5 0 0 1 60,40 H32 A5,5 0 0 1 32,30 Z
                           M32,48 H52 A5,5 0 0 1 52,58 H32 A5,5 0 0 1 32,48 Z"/>

    <!--
      How that glyph is laid into a square tile for the tray and the .ico: a squircle in the
      state colour with the glyph knocked out in white.

      These live here, rather than in the two renderers, because there are two of them —
      TrayIcons draws the live tray icon and tools\make-icon.ps1 writes Teezy.ico, and a tray
      that disagreed with the taskbar would be the kind of drift nobody notices for months.
      Both read these values out of this file. Neither hardcodes the glyph's own bounds
      either; they take them from the geometry above, so re-drawing it re-centres itself.
    -->
    <sys:Double x:Key="MarkTileInset">1.5</sys:Double>
    <sys:Double x:Key="MarkTileRadius">30</sys:Double>
    <sys:Double x:Key="MarkGlyphFill">0.66</sys:Double>

    <FontFamily x:Key="DisplayFont">Georgia, Cambria, Segoe UI Variable Display, serif</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- ============================== Type styles ============================== -->

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="27"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Lede" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="StatCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
    </Style>

    <!-- ============================== Surfaces ============================== -->

    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <Style x:Key="CautionPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CautionBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CautionBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="13,11"/>
    </Style>

    <!-- ============================== Buttons ============================== -->

    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hairline}"/>
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Body}"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only action, for row hover controls. -->
    <Style x:Key="Quiet" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Inputs ============================== -->

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{StaticResource Sunken}" CornerRadius="9"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A switch rather than a tick box. Settings here are all on/off preferences, and a switch
      reads its state from across the room where a small tick does not.
    -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>

                        <Border x:Name="Track" Grid.Column="1" Width="40" Height="23" CornerRadius="12"
                                Background="{StaticResource Hairline}" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small tick box, for list rows where a switch would be too heavy. -->
    <Style x:Key="Tick" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                            Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1.5">
                        <Path x:Name="Check" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented radio, for small either/or choices. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Card}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: the stock WPF chrome is the single most dated-looking control here. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{StaticResource Sunken}" CornerRadius="9"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Path x:Name="Arrow" Data="M1,1 L5,5 L9,1" Stroke="{StaticResource Muted}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Picker" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          Margin="13,0,36,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Card}" CornerRadius="10" Margin="0,4,0,0"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.13"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260" Margin="5">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Picker}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PickerItem}"/>

    <!-- Slim scrollbar, so a long list does not end in a grey slab. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#33000000" CornerRadius="4" Margin="2,0"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Ink}" CornerRadius="7" Padding="9,6">
                        <ContentPresenter TextBlock.Foreground="White" TextBlock.FontSize="11.5"
                                          TextBlock.FontFamily="{StaticResource UiFont}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
