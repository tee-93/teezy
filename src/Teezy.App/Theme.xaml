<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      The whole design system. Views must not contain literal colours, sizes or radii: if a
      component needs a value that is not here, add it here.

      THIS IS FIVEBAR'S SYSTEM, WITH TEEZYFLOW'S OWN ACCENT. Both are Teezy Labs products and
      are meant to read as one family: the same cool blue-grey panels in four steps of
      elevation, one-pixel lines instead of shadows, compact Segoe UI, 4 px controls and 8 px
      cards, small uppercase section labels, and one accent used only for the thing to act on.
      The values are Fivebar's own, from src\renderer\src\styles.css in that repo — keep them
      in step rather than tuning them here.

      THE ACCENT IS TEAL, not Fivebar's orange: the family shares everything but its colour,
      the way Word and Excel do. RED IS RESERVED. It means recording and appears nowhere else.

      Dark only for now. Every lookup in the app is StaticResource, so a light theme means
      moving to DynamicResource first — see the README.
    -->

    <!-- ============================== Surfaces ============================== -->

    <!-- The outermost layer: the top strip. Fivebar's document-tab strip. -->
    <SolidColorBrush x:Key="Chrome"   Color="#141619"/>
    <SolidColorBrush x:Key="Rail"     Color="#141619"/>

    <!-- The page itself, and the well an input sits in. -->
    <SolidColorBrush x:Key="Paper"    Color="#1B1D21"/>
    <SolidColorBrush x:Key="Sunken"   Color="#1B1D21"/>

    <!-- Cards, panels, the status bar, dialogs. -->
    <SolidColorBrush x:Key="Card"     Color="#25282D"/>

    <!-- One step up: default button fill, row hover, menus. -->
    <SolidColorBrush x:Key="Raised"   Color="#2E3238"/>
    <SolidColorBrush x:Key="Hover"    Color="#2E3238"/>

    <!-- Two steps up: pressed or selected rows, notices. -->
    <SolidColorBrush x:Key="Selected" Color="#363B42"/>

    <!-- Every line in the app is this, one pixel wide. -->
    <SolidColorBrush x:Key="Hairline" Color="#3A3F46"/>

    <!-- ============================== Text ============================== -->

    <SolidColorBrush x:Key="Ink"   Color="#E6E8EB"/>
    <SolidColorBrush x:Key="Body"  Color="#C5CAD1"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA1AB"/>
    <SolidColorBrush x:Key="Faint" Color="#767D87"/>

    <!-- ============================== Accent ============================== -->

    <!--
      Teal. Fills, focus borders and selection bars. Text on it is dark, as on Fivebar's
      orange: white on this teal is only about 2.6:1, dark ink is over 7:1.
    -->
    <Color x:Key="AccentColor">#2BB3A3</Color>
    <SolidColorBrush x:Key="Accent"      Color="#2BB3A3"/>
    <SolidColorBrush x:Key="AccentDeep"  Color="#3CC7B6"/>
    <SolidColorBrush x:Key="OnAccent"    Color="#111417"/>

    <!-- The accent at 16% over whatever is beneath: active toggles, selected rows, tags. -->
    <SolidColorBrush x:Key="AccentSoft"  Color="#292BB3A3"/>

    <!-- The accent as text or a link, a step lighter so it reads on every surface. -->
    <SolidColorBrush x:Key="AccentInk"   Color="#5ED6C7"/>

    <!-- Kept for the places that used to take a gradient; there are no gradients any more. -->
    <SolidColorBrush x:Key="AccentWash"  Color="#2BB3A3"/>

    <!-- ============================== Semantic ============================== -->

    <!-- Recording. Nothing else in the app is this colour. -->
    <SolidColorBrush x:Key="Record"        Color="#E5484D"/>
    <SolidColorBrush x:Key="Danger"        Color="#F06A6A"/>
    <SolidColorBrush x:Key="AssistantGood" Color="#3ECF8E"/>
    <SolidColorBrush x:Key="Info"          Color="#7FB2FF"/>

    <!-- Caution: a notice on the raised surface with a bar of the warning hue down its left.
         Only the bar is coloured; the text stays ordinary, as in Fivebar. -->
    <SolidColorBrush x:Key="CautionBg"     Color="#363B42"/>
    <SolidColorBrush x:Key="CautionBorder" Color="#E8B04A"/>
    <SolidColorBrush x:Key="CautionInk"    Color="#C5CAD1"/>

    <!-- The streak heatmap: empty, then the accent mixed over the card at 25, 45, 70 and 100%. -->
    <SolidColorBrush x:Key="Heat0" Color="#2E3238"/>
    <SolidColorBrush x:Key="Heat1" Color="#264B4A"/>
    <SolidColorBrush x:Key="Heat2" Color="#286662"/>
    <SolidColorBrush x:Key="Heat3" Color="#298980"/>
    <SolidColorBrush x:Key="Heat4" Color="#2BB3A3"/>

    <!-- ============================== Floating pills ============================== -->

    <!--
      Dictation and the assistant share one pane, so they read as one object in two modes.
      It is Fivebar's floating-overlay recipe — the panel colour, nearly opaque, with a
      one-pixel line and a shadow — rather than glass: nothing else in the family is glass.

      The key names are the old ones so the two windows keep compiling; PillSheen is now clear.
      PillRadius is a CornerRadius and not a Double on purpose: a resource is assigned as-is,
      and a Double here builds fine and throws the moment the window is constructed.
    -->
    <SolidColorBrush x:Key="PillGlass" Color="#F725282D"/>
    <SolidColorBrush x:Key="PillEdge"  Color="#3A3F46"/>
    <SolidColorBrush x:Key="PillSheen" Color="Transparent"/>
    <SolidColorBrush x:Key="HudText"   Color="#E6E8EB"/>
    <SolidColorBrush x:Key="HudMeter"  Color="#E6E8EB"/>

    <CornerRadius x:Key="PillRadius">10</CornerRadius>
    <sys:Double x:Key="PillHeight">50</sys:Double>

    <!-- How wide an answer may be: two sentences rarely run past three lines. -->
    <sys:Double x:Key="AnswerWidth">380</sys:Double>

    <SolidColorBrush x:Key="AssistantWave" Color="#2BB3A3"/>

    <!-- ============================== The mark ============================== -->

    <!--
      The TeezyFlow mark: four rounded bars at different heights — a voice level. It is built
      the way Fivebar's mark is built (flat bars, the same bar-to-gap ratio and corner, no tile,
      no gradient), so the two sit side by side as one family. Fivebar's bars stand full height
      and are cut on a diagonal; these rise and fall, because this product is a voice.

      One geometry on a 100x100 grid for every size. The proportions are Fivebar's small-size
      ones (bar 17.5, gap 10), because at 16 px a thinner gap closes up and four bars become a
      smudge. TrayIcons and tools\make-icon.ps1 both render THIS resource, so the tray, the
      taskbar and the window cannot disagree.
    -->
    <GeometryGroup x:Key="MarkGeometry">
        <RectangleGeometry Rect="0,26,17.5,48"     RadiusX="3" RadiusY="3"/>
        <RectangleGeometry Rect="27.5,0,17.5,100"  RadiusX="3" RadiusY="3"/>
        <RectangleGeometry Rect="55,13,17.5,74"    RadiusX="3" RadiusY="3"/>
        <RectangleGeometry Rect="82.5,32,17.5,36"  RadiusX="3" RadiusY="3"/>
    </GeometryGroup>

    <!-- The mark's colour, and how much of an icon square it fills (Fivebar insets 40 of 512). -->
    <Color x:Key="MarkColor">#2BB3A3</Color>
    <sys:Double x:Key="MarkGlyphFill">0.84</sys:Double>

    <DrawingImage x:Key="MarkImage">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{StaticResource Accent}" Geometry="{StaticResource MarkGeometry}"/>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================== Type ============================== -->

    <!--
      Segoe UI for everything, as in Fivebar. Outfit Bold — the Teezy Labs display face — for
      the home greeting and the wordmark only, and nowhere else.
    -->
    <FontFamily x:Key="BrandFont">pack://application:,,,/Teezy;component/Fonts/#Outfit</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- The home greeting. -->
    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- A page title. -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- A card or dialog heading. -->
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="Lede" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Small capitals over a group, as in Fivebar. The text itself is written in capitals. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Every figure is tabular and semibold, so columns of numbers line up. -->
    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <Style x:Key="StatCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <!-- ============================== Surfaces ============================== -->

    <!-- Flat: the panel colour, one line, 8 px corners, no shadow. -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- A card with no padding, for lists whose rows run edge to edge. -->
    <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Fivebar's notice: the raised surface with a bar down the left in the warning hue. -->
    <Style x:Key="CautionPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CautionBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CautionBorder}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- A key or key combination, as Fivebar draws kbd. -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
    </Style>

    <!-- A small tag: the accent at 16% with accent text. -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,1"/>
    </Style>

    <Style x:Key="TagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
    </Style>

    <!-- A wrapper that makes a PasswordBox or a bare TextBox look like a Field. -->
    <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Sunken}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!-- ============================== Buttons ============================== -->

    <!-- The one thing to act on. Accent fill, dark text. -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{TemplateBinding Background}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default button: raised fill, a line, and the line turns accent on hover. -->
    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Raised}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only action, for row hover controls. -->
    <Style x:Key="Quiet" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A square icon in the top strip — the settings gear — that is also a page, so it joins the
      tabs' group and shows the accent while its page is open. Content is a Path whose Stroke
      binds to the button's Foreground.
    -->
    <Style x:Key="IconTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A page tab in the top strip, as Fivebar draws its document tabs. The active tab takes the
      page colour and a line on three sides, and sits one pixel low so it covers the strip's
      bottom line and merges into the page below it.
    -->
    <Style x:Key="TopTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,2,-1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6,6,0,0"
                            BorderBrush="Transparent" BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Paper}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Hairline}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A settings section in the left-hand list, as in Fivebar's Settings: the chosen one is
      raised, semibold, with the accent bar down its left edge. A RadioButton so the group
      keeps exactly one chosen by itself.
    -->
    <Style x:Key="SettingsTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6"
                                Background="{StaticResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Selected}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      A list that looks like nothing: no chrome, no scrollbar, no selection wash. For short
      lists inside a card, where a ListBox's own border would draw a box inside a box.
    -->
    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      One row of a PlainList: transparent until hovered. Selection is deliberately not painted —
      clicking a row opens something rather than putting the list into a state.
    -->
    <Style x:Key="InboxRowItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="Margin" Value="-6,0,-6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The header of a dashboard widget, which grows and shrinks it. The whole row is the target;
      checked means enlarged, and the chevron turns rather than snapping so the change is seen.
    -->
    <Style x:Key="SectionToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="6,4" Margin="-6,-4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <Path x:Name="Chevron" Grid.Column="1" Data="M1,1 L5,5 L9,1" Width="10" Height="6"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="14,0,1,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Inputs ============================== -->

    <!-- Recessed below the panel it sits on; focus turns the line accent. No focus ring. -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{StaticResource Sunken}" CornerRadius="4"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A bare TextBox or PasswordBox inside a FieldBox: no chrome of its own. -->
    <Style x:Key="BareText" TargetType="Control">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- A switch. On is the accent, as every other "on" in the app. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>

                        <Border x:Name="Track" Grid.Column="1" Width="34" Height="18" CornerRadius="9"
                                Background="{StaticResource Selected}" BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{StaticResource Muted}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ink}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                            <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small tick box, for list rows where a switch would be too heavy. -->
    <Style x:Key="Tick" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                            Background="{StaticResource Sunken}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Path x:Name="Check" Data="M3.5,8 L6.5,11 L12,5" Stroke="{StaticResource OnAccent}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      One segment of a segmented control. The container is a SegmentGroup border; the chosen
      segment is filled with the accent, as in Fivebar.
    -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="4" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox. The stock WPF chrome is the most dated-looking control there is. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{StaticResource Sunken}" CornerRadius="4"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <Path x:Name="Arrow" Data="M1,1 L5,5 L9,1" Stroke="{StaticResource Muted}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Picker" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          Margin="9,0,30,0" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                        <!-- Solid, not see-through: a menu floats over content and must hide it. -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{StaticResource Raised}" CornerRadius="6" Margin="0,3,12,14"
                                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.45"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" Margin="4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PickerItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" CornerRadius="4,0,0,4"
                                Background="{StaticResource Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Selected}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource Picker}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PickerItem}"/>

    <!-- Slim scrollbar, visible on the dark ground. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="T" Background="#4A5058" CornerRadius="4" Margin="2,2"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="T" Property="Background" Value="#5E656F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Hairline}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5">
                        <ContentPresenter TextBlock.Foreground="{StaticResource Ink}" TextBlock.FontSize="12"
                                          TextBlock.FontFamily="{StaticResource UiFont}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
