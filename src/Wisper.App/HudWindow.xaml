<Window x:Class="Wisper.App.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False">

    <Border x:Name="Pill"
            CornerRadius="22"
            Padding="18,11"
            MinWidth="180"
            Background="#F21C1C1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Red means recording. Nothing else in this app is red. -->
            <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FF3B30"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- Level meter. Bars are sized in code-behind from the RMS level. -->
            <StackPanel x:Name="Meter" Orientation="Horizontal" VerticalAlignment="Center"
                        Height="26" Margin="0,0,12,0"/>

            <TextBlock x:Name="StatusText"
                       Text="Listening"
                       Foreground="#E8E8ED"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
