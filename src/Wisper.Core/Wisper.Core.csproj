<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0, no -windows suffix. This is the guardrail: CA1416 is escalated to an
         error in Directory.Build.props, so any Win32 call that drifts into this project
         fails the build instead of quietly becoming untestable code. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Wisper.Core.Tests" />
  </ItemGroup>
</Project>
