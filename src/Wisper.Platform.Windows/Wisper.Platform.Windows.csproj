<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ONLY project allowed to contain Win32 code. Everything here is code CI cannot
         exercise, so it stays as logic-free as possible: retries, debouncing and device
         handling belong in the neutral projects, behind an interface. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wisper.Core\Wisper.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>
</Project>
